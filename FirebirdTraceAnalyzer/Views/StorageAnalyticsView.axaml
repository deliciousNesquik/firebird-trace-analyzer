<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:st="using:FirebirdTraceAnalyzer.Models.Storage"
             xmlns:uc="using:FirebirdTraceAnalyzer.UserControls"
             xmlns:sys="using:System"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
             x:Class="FirebirdTraceAnalyzer.Views.StorageAnalyticsView"
             x:DataType="vm:StorageAnalyticsViewModel"
             Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=uc:DialogHost}, Converter={StaticResource SubtractConverter}, ConverterParameter=48}"
             Height="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=uc:DialogHost}, Converter={StaticResource SubtractConverter}, ConverterParameter=48}">

    <Design.DataContext>
        <vm:StorageAnalyticsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*" Margin="12">

        <!-- Тулбар -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8">
            <Button Grid.Column="0"
                    Content="{loc:Tr Store.Analyze.Run}"
                    Command="{Binding RunQueryCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Classes="accent"
                    Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    Content="{loc:Tr Store.Analyze.ExportCsv}"
                    Command="{Binding ExportCsvCommand}"
                    IsEnabled="{Binding HasResult}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Margin="12,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Grid.Column="3"
                    Content="{loc:Tr Common.Cancel}"
                    Command="{Binding CloseCommand}" />
        </Grid>

        <!-- Индикатор выполнения запроса -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}"
                     Height="3"
                     Margin="0,0,0,8" />

        <!-- Рабочая область: слева редактор+результат, справа помощники -->
        <Grid Grid.Row="2" ColumnDefinitions="*,4,320">

            <!-- Левая колонка -->
            <Grid Grid.Column="0" RowDefinitions="2*,4,3*">
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <TextBox Text="{Binding SqlText}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                             FontSize="13"
                             Watermark="SELECT ... FROM event ..."
                             VerticalContentAlignment="Top"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Border>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}" />

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <Panel>
                        <!-- Динамический грид результата строится в code-behind -->
                        <ScrollViewer x:Name="ResultHost"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="{loc:Tr Store.Analyze.NoResult}"
                                   IsVisible="{Binding !HasResult}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Panel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" />

            <!-- Правая панель: помощники -->
            <ScrollViewer Grid.Column="2" Padding="8,0,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">

                    <!-- Конструктор: показатели + разрезы + фильтры → генерация SQL -->
                    <Expander Header="{loc:Tr Store.Analyze.Section.Builder}" IsExpanded="True"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">

                            <TextBlock Text="{loc:Tr Store.Analyze.Builder.Measures}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Measures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MeasureItem">
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{loc:Tr Store.Analyze.Builder.Dimensions}" FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{Binding Dimensions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DimensionItem">
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{loc:Tr Store.Analyze.Builder.Filters}" FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{loc:Tr Store.Analyze.Builder.Period}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding Periods}"
                                      SelectedItem="{Binding SelectedPeriod}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PeriodItem">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{loc:Tr Store.Analyze.Builder.User}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding BuilderUser}" />
                            <TextBlock Text="{loc:Tr Store.Analyze.Builder.Limit}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <NumericUpDown Value="{Binding BuilderLimit}"
                                           Minimum="1" Maximum="1000000" Increment="100"
                                           FormatString="0" />

                            <Button Content="{loc:Tr Store.Analyze.Builder.Generate}"
                                    Command="{Binding GenerateSqlCommand}"
                                    HorizontalAlignment="Stretch"
                                    Classes="accent"
                                    Margin="0,6,0,0" />
                        </StackPanel>
                    </Expander>

                    <!-- Готовые запросы -->
                    <Expander Header="{loc:Tr Store.Analyze.Section.Prebuilt}" IsExpanded="True"
                              HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding Prebuilt}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="st:PrebuiltQuery">
                                    <Button Content="{Binding Name}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,2"
                                            Command="{Binding $parent[UserControl].((vm:StorageAnalyticsViewModel)DataContext).LoadPrebuiltCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- Схема БД -->
                    <Expander Header="{loc:Tr Store.Analyze.Section.Schema}" IsExpanded="True"
                              HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding Schema}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="st:SchemaTable">
                                    <Expander Header="{Binding Name}" IsExpanded="False" Margin="0,1"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch">
                                        <ItemsControl ItemsSource="{Binding Columns}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <Button Content="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="8,2"
                                                            FontSize="12"
                                                            Command="{Binding $parent[UserControl].((vm:StorageAnalyticsViewModel)DataContext).InsertTokenCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
