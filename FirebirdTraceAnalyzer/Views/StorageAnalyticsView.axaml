<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:st="using:FirebirdTraceAnalyzer.Models.Storage"
             xmlns:uc="using:FirebirdTraceAnalyzer.UserControls"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
             x:Class="FirebirdTraceAnalyzer.Views.StorageAnalyticsView"
             x:DataType="vm:StorageAnalyticsViewModel"
             Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=uc:DialogHost}, Converter={StaticResource SubtractConverter}, ConverterParameter=48}"
             Height="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=uc:DialogHost}, Converter={StaticResource SubtractConverter}, ConverterParameter=48}">

    <Design.DataContext>
        <vm:StorageAnalyticsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*" Margin="12">

        <!-- Тулбар -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,8">
            <Button Grid.Column="0"
                    Content="{loc:Tr Store.Analyze.Run}"
                    Command="{Binding RunQueryCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Classes="accent"
                    Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Prebuilt}"
                      SelectedItem="{Binding SelectedPrebuilt}"
                      PlaceholderText="{loc:Tr Store.Analyze.Section.Prebuilt}"
                      MinWidth="190"
                      Margin="0,0,8,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="st:PrebuiltQuery">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2"
                    Content="{loc:Tr Store.Analyze.ExportCsv}"
                    Command="{Binding ExportCsvCommand}"
                    IsEnabled="{Binding HasResult}" />
            <TextBlock Grid.Column="3"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Margin="12,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Grid.Column="4"
                    Content="{loc:Tr Common.Cancel}"
                    Command="{Binding CloseCommand}" />
        </Grid>

        <!-- Индикатор выполнения запроса -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}"
                     Height="3"
                     Margin="0,0,0,8" />

        <!-- Рабочая область: редактор + результат на всю ширину -->
        <Grid Grid.Row="2" RowDefinitions="2*,4,3*">
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                        ClipToBounds="True">
                    <Panel>
                        <!-- SQL-редактор с подсветкой (AvaloniaEdit). Текст ↔ VM.SqlText связывается в code-behind. -->
                        <ae:TextEditor x:Name="SqlEditor"
                                       ShowLineNumbers="True"
                                       WordWrap="False"
                                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                       FontSize="{Binding EditorFontSize}"
                                       Padding="4"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto" />

                        <!-- Бейдж масштаба шрифта (как в редакторе отчётов) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="4"
                                BoxShadow="0 4 14 0 #33000000">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Content="−" Width="30" Height="30" Padding="0" FontSize="16" Classes="normal"
                                        Command="{Binding FontZoomOutCommand}"
                                        ToolTip.Tip="{loc:Tr ReportPreview.ZoomOut}" />
                                <Button Content="{Binding EditorZoomPercent}" MinWidth="52" Height="30" Padding="4,0"
                                        Classes="normal"
                                        Command="{Binding FontZoomResetCommand}"
                                        ToolTip.Tip="{loc:Tr ReportPreview.ZoomReset}" />
                                <Button Content="+" Width="30" Height="30" Padding="0" FontSize="16" Classes="normal"
                                        Command="{Binding FontZoomInCommand}"
                                        ToolTip.Tip="{loc:Tr ReportPreview.ZoomIn}" />
                            </StackPanel>
                        </Border>
                    </Panel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}" />

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <Panel>
                        <!-- Динамический грид результата строится в code-behind -->
                        <ScrollViewer x:Name="ResultHost"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="{loc:Tr Store.Analyze.NoResult}"
                                   IsVisible="{Binding !HasResult}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Panel>
                </Border>
        </Grid>
    </Grid>
</UserControl>
