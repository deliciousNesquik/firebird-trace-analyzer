<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="900"
             x:Class="FirebirdTraceAnalyzer.Views.ReportPreviewView"
             x:CompileBindings="False">

    <Design.DataContext>
        <vm:ReportPreviewViewModel />
    </Design.DataContext>

    <!-- Превью — точная визуальная копия PDF-экспорта (QuestPDF): белый лист, чёрный текст,
         те же цвета/размеры/границы. Таблица событий строится ЕДИНЫМ Grid в code-behind, поэтому
         заголовок и строки делят одни и те же колонки — выравнивание идентично PDF. -->
    <Grid>
        <ScrollViewer Background="{DynamicResource AppBackgroundBrush}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <LayoutTransformControl x:Name="PageTransform" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="28">

                    <!-- Лист документа -->
                    <Border Background="White"
                            Width="820"
                            Padding="48,44"
                            BoxShadow="0 6 22 0 #2A000000">
                        <StackPanel Spacing="10">

                            <!-- Header -->
                            <TextBlock Text="{Binding PreviewTitle}"
                                       FontSize="18" FontWeight="Bold"
                                       TextAlignment="Center" Foreground="#1976D2" />
                            <TextBlock Text="{Binding PreviewSubtitle}"
                                       FontSize="12" FontStyle="Italic"
                                       TextAlignment="Center" Foreground="#757575"
                                       IsVisible="{Binding PreviewSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding GeneratedDateText}"
                                       FontSize="9" TextAlignment="Right" Foreground="#757575"
                                       IsVisible="{Binding GeneratedDateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <Border Height="1" Background="#BDBDBD" Margin="0,5" />

                            <!-- Header variables: две равные колонки, метка жирная -->
                            <ItemsControl ItemsSource="{Binding HeaderVariables}"
                                          IsVisible="{Binding HeaderVariables.Count}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       FontSize="9" FontWeight="Bold" Foreground="Black" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       FontSize="9" Foreground="Black" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Events section -->
                            <TextBlock Text="Events" FontSize="14" FontWeight="Bold"
                                       Foreground="#1E88E5" Margin="0,6,0,0" />

                            <!-- Единая таблица (header + строки), строится в code-behind -->
                            <Grid x:Name="EventsTableGrid" />

                            <!-- Statistics -->
                            <StackPanel Spacing="3" IsVisible="{Binding Statistics.Count}">
                                <TextBlock Text="Summary Statistics" FontSize="14" FontWeight="Bold"
                                           Foreground="#1E88E5" Margin="0,6,0,0" />
                                <ItemsControl ItemsSource="{Binding Statistics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,*" Margin="0,1">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           FontSize="10" FontWeight="Bold" Foreground="Black" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           FontSize="10" Foreground="Black" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Footer -->
                            <StackPanel Spacing="5" Margin="0,6,0,0"
                                        IsVisible="{Binding FooterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Border Height="1" Background="#BDBDBD" />
                                <TextBlock Text="{Binding FooterText}" FontSize="8" Foreground="#757575" />
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Честное примечание об усечении — вне листа -->
                    <TextBlock Text="{Binding RowNote}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding RowNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                </StackPanel>
            </LayoutTransformControl>
        </ScrollViewer>

        <!-- Зум-панель -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="4"
                BoxShadow="0 4 14 0 #33000000">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Content="−" Width="30" Height="30" Padding="0"
                        FontSize="16" Classes="normal"
                        Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out" />
                <Button Content="{Binding ZoomPercent}" MinWidth="52" Height="30" Padding="4,0"
                        Classes="normal"
                        Command="{Binding ZoomResetCommand}" ToolTip.Tip="Reset to 100%" />
                <Button Content="+" Width="30" Height="30" Padding="0"
                        FontSize="16" Classes="normal"
                        Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
