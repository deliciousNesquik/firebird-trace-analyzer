<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="FirebirdTraceAnalyzer.Views.RemoteFileSelectionDialogView"
             x:DataType="vm:RemoteFileSelectionViewModel"
             Width="860"
             MaxHeight="680">

    <Design.DataContext>
        <vm:RemoteFileSelectionViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <StackPanel Spacing="4">
                <TextBlock Text="Select Files for Download"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="Server:" />
                    <Run Text="{Binding ServerInfo}" FontWeight="Medium" />
                </TextBlock>

                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="Directory:" />
                    <Run Text="{Binding RemoteDirectory}" FontWeight="Medium" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Search and Filters -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">

                <!-- Search -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText}"
                         PlaceholderText="Search files..."
                         VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ApplySearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <!-- Clear Search -->
                <Button Grid.Column="1"
                        Classes="danger"
                        Command="{Binding ClearSearchCommand}"
                        IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Height="40" Width="40"
                        ToolTip.Tip="Clear search" >
                    <Button.Content>
                        <Svg Width="40" Path="{DynamicResource ClearIcon}" Css="{DynamicResource ThemeIconFillOnlyWhite}" />
                    </Button.Content>

                </Button>

                <!-- Date Filter -->
                <Button Grid.Column="2" Height="40" Width="40" Classes="normal">
                    <Button.Content>
                        <Svg Width="40" Path="{DynamicResource FilterIcon}" Css="{DynamicResource ThemeIconStroke}" />
                    </Button.Content>
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuItem Header="Today" Command="{Binding FilterByDateCommand}" CommandParameter="today" />
                            <MenuItem Header="Yesterday" Command="{Binding FilterByDateCommand}" CommandParameter="yesterday" />
                            <MenuItem Header="Last 7 days" Command="{Binding FilterByDateCommand}" CommandParameter="week" />
                            <MenuItem Header="Last 30 days" Command="{Binding FilterByDateCommand}" CommandParameter="month" />
                            <Separator />
                            <MenuItem Header="All files" Command="{Binding ClearSearchCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>

                </Button>

                <!-- Refresh -->
                <Button Grid.Column="3"
                        Classes="normal"
                        Height="40" Width="40"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh file list" >
                    <Button.Content>
                        <Svg Width="40" Path="{DynamicResource ReloadIcon}" Css="{DynamicResource ThemeIconFill}" />
                    </Button.Content>
                </Button>
            </Grid>
        </Border>

        <!-- File List -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppBackgroundBrush}"
                Padding="20">

            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Предупреждение: включено удаление файлов с сервера после обработки -->
                <Border Grid.Row="0"
                        Background="{DynamicResource WarningSurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12"
                        IsVisible="{Binding DeleteAfterProcessing}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Delete from server is enabled"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Text="Downloaded files will be permanently removed from the server after processing. To turn this off, uncheck “Delete files from the server” in the connection dialog."
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Selection Controls -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5" Margin="0,0,0,12">
                    <Button Grid.Column="0"
                            Content="Select All"
                            Classes="focused"
                            Command="{Binding SelectAllCommand}"/>

                    <Button Grid.Column="1"
                            Content="Deselect All"
                            Classes="danger"
                            Command="{Binding DeselectAllCommand}"/>
                </Grid>

                <!-- Files -->
                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding FilteredFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12"
                                        Margin="0,0,0,8">

                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  Command="{Binding $parent[UserControl].((vm:RemoteFileSelectionViewModel)DataContext).ToggleFileSelectionCommand}"
                                                  CommandParameter="{Binding}" />

                                        <!-- File Info -->
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="Medium"
                                                       FontSize="13" />

                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="Modified:" />
                                                <Run Text="{Binding FormattedDate}" />
                                                <Run Text=" • " />
                                                <Run Text="{Binding FormattedSize}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Owner -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Owner}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0" />

                                        <!-- Permissions -->
                                        <TextBlock Grid.Column="3"
                                                   FontSize="11"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding Permissions.OwnerCanRead, Converter={StaticResource BoolToPermissionConverter}, ConverterParameter=r}" />
                                            <Run Text="{Binding Permissions.OwnerCanWrite, Converter={StaticResource BoolToPermissionConverter}, ConverterParameter=w}" />
                                            <Run Text="{Binding Permissions.OwnerCanExecute, Converter={StaticResource BoolToPermissionConverter}, ConverterParameter=x}" />
                                            <Run Text="{Binding Permissions.GroupCanRead, Converter={StaticResource BoolToPermissionConverter}, ConverterParameter=r}" />
                                            <Run Text="{Binding Permissions.GroupCanWrite, Converter={StaticResource BoolToPermissionConverter}, ConverterParameter=w}" />
                                            <Run Text="{Binding Permissions.GroupCanExecute, Converter={StaticResource BoolToPermissionConverter}, ConverterParameter=x}" />
                                            <Run Text="{Binding Permissions.OthersCanRead, Converter={StaticResource BoolToPermissionConverter}, ConverterParameter=r}" />
                                            <Run Text="{Binding Permissions.OthersCanWrite, Converter={StaticResource BoolToPermissionConverter}, ConverterParameter=w}" />
                                            <Run Text="{Binding Permissions.OthersCanExecute, Converter={StaticResource BoolToPermissionConverter}, ConverterParameter=x}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">

                <!-- Сводка по выбору: статус слева, метрики справа (заполняет нижнюю часть) -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="24">

                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Selected"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="{Binding SelectedCount}" />
                                <Run Text="file(s)" />
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Width="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,2" />

                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Total size"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding SelectedTotalSize, Converter={StaticResource BytesToReadableSizeConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Buttons -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">

                    <Button Grid.Column="1"
                            Content="Download and Process"
                            Classes="focused"
                            MinWidth="190"
                            Command="{Binding ConfirmCommand}"/>

                    <Button Grid.Column="2"
                            Content="Cancel"
                            Classes="danger"
                            Command="{Binding CancelCommand}"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
