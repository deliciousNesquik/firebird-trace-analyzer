<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="using:FirebirdTraceAnalyzer.Enums"
             xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="700"
             x:Class="FirebirdTraceAnalyzer.Views.RemoteConnectionDialogView"
             x:DataType="vm:RemoteConnectionDialogViewModel"
             Width="620"
             MaxHeight="760">

    <Design.DataContext>
        <vm:RemoteConnectionDialogViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Карточка-секция: визуально отделяет логические группы полей -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.sectionHint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.fieldHint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Remote.Connection.Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock Text="{loc:Tr Remote.Connection.Subtitle}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Stretch">
            <StackPanel Spacing="12" Margin="20">

                <!-- Profiles: загрузка и сохранение подключения — в самом верху -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionTitle" Text="{loc:Tr Remote.Connection.Profiles.Title}" />
                            <TextBlock Classes="sectionHint"
                                       Text="{loc:Tr Remote.Connection.Profiles.Hint}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="fieldLabel" Text="{loc:Tr Remote.Connection.Profiles.LoadLabel}" />
                            <ComboBox ItemsSource="{Binding SavedProfiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      PlaceholderText="{loc:Tr Remote.Connection.Profiles.NoProfileSelected}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Карточка профиля: слева имя/хост, справа действия.
                                             Команды берём у VM окна через $parent[ComboBox], параметр — сам профиль.
                                             Content кнопок — временный текст, иконки подставишь позже. -->
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Settings.Hostname}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Padding="5,5"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{loc:Tr Remote.Connection.Profiles.OpenFile}"
                                                    IsVisible="{Binding $parent[ComboBox].((vm:RemoteConnectionDialogViewModel)DataContext).SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Command="{Binding $parent[ComboBox].((vm:RemoteConnectionDialogViewModel)DataContext).OpenProfileFileCommand}">
                                                <Svg Width="20" Height="20" Path="{DynamicResource FileSearchIcon}"
                                                     Css="{DynamicResource ThemeIconFill}" />
                                            </Button>

                                            <Button Grid.Column="2"
                                                    Padding="5,5"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{loc:Tr Remote.Connection.Profiles.Duplicate}"
                                                    IsVisible="{Binding $parent[ComboBox].((vm:RemoteConnectionDialogViewModel)DataContext).SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Command="{Binding $parent[ComboBox].((vm:RemoteConnectionDialogViewModel)DataContext).DuplicateProfileCommand}"
                                                    CommandParameter="{Binding}" >

                                                <Svg Width="20" Height="20" Path="{DynamicResource CopyIcon}"
                                                     Css="{DynamicResource ThemeIconFill}" />
                                            </Button>

                                            <Button Grid.Column="3"
                                                    Classes="danger"
                                                    Padding="5,5"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{loc:Tr Remote.Connection.Profiles.Delete}"
                                                    IsVisible="{Binding $parent[ComboBox].((vm:RemoteConnectionDialogViewModel)DataContext).SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Command="{Binding $parent[ComboBox].((vm:RemoteConnectionDialogViewModel)DataContext).DeleteProfileCommand}"
                                                    CommandParameter="{Binding}">

                                                <Svg Width="20" Height="20" Path="{DynamicResource TrashIcon}"
                                                     Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="{loc:Tr Remote.Connection.Profiles.SaveAsLabel}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         Text="{Binding ProfileName}"
                                         PlaceholderText="{loc:Tr Remote.Connection.Profiles.NamePlaceholder}"
                                         IsEnabled="{Binding !IsConnecting}" />

                                <Button Grid.Column="1"
                                        Content="{loc:Tr Remote.Connection.Profiles.Save}"
                                        Classes="focused"
                                        Command="{Binding SaveProfileCommand}"
                                        IsEnabled="{Binding !IsConnecting}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 2: Server -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionTitle" Text="{loc:Tr Remote.Connection.Server.Title}" />
                            <TextBlock Classes="sectionHint" Text="{loc:Tr Remote.Connection.Server.Hint}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="{loc:Tr Remote.Connection.Server.HostnameLabel}" />
                            <TextBox Text="{Binding Hostname}"
                                     PlaceholderText="{loc:Tr Remote.Connection.Server.HostnamePlaceholder}"
                                     IsEnabled="{Binding !IsConnecting}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{loc:Tr Remote.Connection.Server.UsernameLabel}" />
                                <TextBox Text="{Binding Username}"
                                         PlaceholderText="{loc:Tr Remote.Connection.Server.UsernamePlaceholder}"
                                         IsEnabled="{Binding !IsConnecting}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{loc:Tr Remote.Connection.Server.PortLabel}" />
                                <NumericUpDown Value="{Binding Port}"
                                               Minimum="1"
                                               Maximum="65535"
                                               IsEnabled="{Binding !IsConnecting}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Step 3: Authentication -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionTitle" Text="{loc:Tr Remote.Connection.Auth.Title}" />
                            <TextBlock Classes="sectionHint" Text="{loc:Tr Remote.Connection.Auth.Hint}" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <RadioButton Content="{loc:Tr Remote.Connection.Auth.PasswordOption}"
                                         IsChecked="{Binding IsPasswordAuthSelected}"
                                         Command="{Binding ChangeAuthMethodCommand}"
                                         GroupName="AuthMethod"
                                         CommandParameter="{x:Static enums:AuthenticationMethod.Password}"
                                         IsEnabled="{Binding !IsConnecting}" />

                            <Border IsVisible="{Binding IsPasswordAuthSelected}"
                                    Padding="24,0,0,0">
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="{loc:Tr Remote.Connection.Auth.PasswordLabel}" />
                                        <TextBox Text="{Binding Password}"
                                                 PasswordChar="{Binding ShowPassword, Converter={StaticResource BoolToPasswordCharConverter}}"
                                                 PlaceholderText="{loc:Tr Remote.Connection.Auth.PasswordPlaceholder}"
                                                 IsEnabled="{Binding !IsConnecting}" />
                                    </StackPanel>

                                    <CheckBox Content="{loc:Tr Remote.Connection.Auth.ShowPassword}"
                                              IsChecked="{Binding ShowPassword}"
                                              FontSize="11" />

                                    <CheckBox Content="{loc:Tr Remote.Connection.Auth.RememberPassword}"
                                              IsChecked="{Binding RememberPassword}"
                                              FontSize="11" />
                                </StackPanel>
                            </Border>

                            <RadioButton Content="{loc:Tr Remote.Connection.Auth.PrivateKeyOption}"
                                         IsChecked="{Binding IsPrivateKeyAuthSelected}"
                                         Command="{Binding ChangeAuthMethodCommand}"
                                         GroupName="AuthMethod"
                                         CommandParameter="{x:Static enums:AuthenticationMethod.PrivateKey}"
                                         IsEnabled="{Binding !IsConnecting}" />

                            <Border IsVisible="{Binding IsPrivateKeyAuthSelected}"
                                    Padding="24,0,0,0">
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="{loc:Tr Remote.Connection.Auth.PrivateKeyFileLabel}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding PrivateKeyPath}"
                                                     PlaceholderText="{loc:Tr Remote.Connection.Auth.PrivateKeyFilePlaceholder}"
                                                     IsEnabled="{Binding !IsConnecting}" />

                                            <Button Grid.Column="1"
                                                    Content="{loc:Tr Remote.Connection.Auth.Browse}"
                                                    Classes="focused"
                                                    Command="{Binding BrowsePrivateKeyCommand}"
                                                    IsEnabled="{Binding !IsConnecting}"
                                                    Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="{loc:Tr Remote.Connection.Auth.PassphraseLabel}" />
                                        <TextBlock Classes="sectionHint" Text="{loc:Tr Remote.Connection.Auth.PassphraseHint}" />
                                        <TextBox Text="{Binding KeyPassphrase}"
                                                 PasswordChar="{Binding ShowKeyPassphrase, Converter={StaticResource BoolToPasswordCharConverter}}"
                                                 PlaceholderText="{loc:Tr Remote.Connection.Auth.PassphrasePlaceholder}"
                                                 IsEnabled="{Binding !IsConnecting}" />
                                    </StackPanel>

                                    <CheckBox Content="{loc:Tr Remote.Connection.Auth.ShowPassphrase}"
                                              IsChecked="{Binding ShowKeyPassphrase}"
                                              FontSize="11" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 4: Trace files location -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionTitle" Text="{loc:Tr Remote.Connection.TraceFiles.Title}" />
                            <TextBlock Classes="sectionHint" Text="{loc:Tr Remote.Connection.TraceFiles.Hint}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="{loc:Tr Remote.Connection.TraceFiles.DirectoryLabel}" />
                            <TextBox Text="{Binding RemoteDirectory}"
                                     PlaceholderText="{loc:Tr Remote.Connection.TraceFiles.DirectoryPlaceholder}"
                                     IsEnabled="{Binding !IsConnecting}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 5: After processing -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionTitle" Text="{loc:Tr Remote.Connection.AfterProcessing.Title}" />
                            <TextBlock Classes="sectionHint" Text="{loc:Tr Remote.Connection.AfterProcessing.Hint}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <CheckBox Content="{loc:Tr Remote.Connection.AfterProcessing.DeleteFromServer}"
                                      IsChecked="{Binding DeleteAfterProcessingFromServer}"
                                      FontWeight="Medium">
                                <CheckBox.Styles>
                                    <Style Selector="CheckBox:checked">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                                    </Style>
                                </CheckBox.Styles>
                            </CheckBox>
                            <TextBlock Classes="fieldHint"
                                       Margin="28,0,0,0"
                                       Text="{loc:Tr Remote.Connection.AfterProcessing.DeleteFromServerHint}" />
                        </StackPanel>

                        <Border Background="{DynamicResource WarningSurfaceBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                IsVisible="{Binding DeleteAfterProcessingFromServer}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Tr Remote.Connection.AfterProcessing.WarningTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningTextBrush}" />
                                <TextBlock Text="{loc:Tr Remote.Connection.AfterProcessing.WarningBody}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource WarningTextBrush}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="4">
                            <CheckBox Content="{loc:Tr Remote.Connection.AfterProcessing.DeleteLocalCopies}"
                                      IsChecked="{Binding DeleteAfterProcessingOnLocaleMachine}"
                                      FontWeight="Medium" />
                            <TextBlock Classes="fieldHint"
                                       Margin="28,0,0,0"
                                       Text="{loc:Tr Remote.Connection.AfterProcessing.DeleteLocalCopiesHint}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <Grid RowDefinitions="Auto,Auto,Auto">

                <!-- Error Message -->
                <Border Grid.Row="0"
                        Background="{DynamicResource ErrorSurfaceBrush}"
                        BorderBrush="{DynamicResource ErrorBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorTextBrush}"
                               FontSize="12" />
                </Border>

                <!-- Status -->
                <StackPanel Grid.Row="1"
                            Spacing="8"
                            Margin="0,10,0,12">

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsConnecting}"
                                 Height="4" />
                </StackPanel>

                <!-- Buttons -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">

                    <Button Grid.Column="0"
                            Content="{loc:Tr Remote.Connection.ValidateParameters}"
                            Classes="normal"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding !IsConnecting}"
                            ToolTip.Tip="{loc:Tr Remote.Connection.ValidateParametersTooltip}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <Button Content="{loc:Tr Remote.Connection.Connect}"
                                Classes="focused"
                                Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding !IsConnecting}" />

                        <Button Content="{loc:Tr Remote.Connection.Cancel}"
                                Classes="danger"
                                Command="{Binding CancelCommand}"
                                IsEnabled="{Binding !IsConnecting}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
