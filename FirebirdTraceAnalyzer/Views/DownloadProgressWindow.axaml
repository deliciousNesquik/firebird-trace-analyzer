<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
        xmlns:models="using:FirebirdTraceAnalyzer.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="580"
        x:Class="FirebirdTraceAnalyzer.Views.DownloadProgressWindow"
        x:DataType="vm:DownloadProgressViewModel"
        Title="Downloading Files"
        Width="600"
        Height="580"
        MinWidth="480"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:DownloadProgressViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Строка файла в списке -->
        <Style Selector="Border.fileRow">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20,16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock Text="Downloading files"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Overall progress -->
        <Border Grid.Row="1" Padding="20,16">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Overall progress"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Grid.Column="1"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding CurrentFileIndex}" FontWeight="SemiBold" />
                        <Run Text="of" />
                        <Run Text="{Binding TotalFiles}" FontWeight="SemiBold" />
                        <Run Text="files" />
                    </TextBlock>
                </Grid>

                <ProgressBar Value="{Binding OverallProgress}"
                             Maximum="100"
                             Height="10"
                             CornerRadius="5" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding TotalBytesTransferred, Converter={StaticResource BytesToReadableSizeConverter}}" />
                        <Run Text="/" />
                        <Run Text="{Binding TotalBytesOverall, Converter={StaticResource BytesToReadableSizeConverter}}" />
                        <Run Text="•" />
                        <Run Text="{Binding DownloadSpeed, Converter={StaticResource SpeedConverter}}" />
                        <Run Text="• Remaining:" />
                        <Run Text="{Binding EstimatedTimeRemaining, Converter={StaticResource TimeSpanToStringConverter}}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding OverallProgress, StringFormat={}{0:F0}%}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Files list -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="20,4,20,12">
            <TextBlock Grid.Row="0"
                       Text="Files"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DownloadFileItem">
                                <Border Classes="fileRow">
                                    <Grid ColumnDefinitions="24,*,Auto" VerticalAlignment="Center">

                                        <!-- Status icon (одна видима) -->
                                        <Panel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="○" FontSize="14"
                                                       IsVisible="{Binding IsPending}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="↓" FontSize="14" FontWeight="Bold"
                                                       IsVisible="{Binding IsDownloading}"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="✓" FontSize="14" FontWeight="Bold"
                                                       IsVisible="{Binding IsCompleted}"
                                                       Foreground="{DynamicResource SuccessBrush}" />
                                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                                       IsVisible="{Binding IsFailed}"
                                                       Foreground="{DynamicResource ErrorTextBrush}" />
                                        </Panel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FileName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                                        <!-- Status label (одна видима) -->
                                        <Panel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Pending" FontSize="11"
                                                       IsVisible="{Binding IsPending}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="Downloading…" FontSize="11" FontWeight="SemiBold"
                                                       IsVisible="{Binding IsDownloading}"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="Done" FontSize="11"
                                                       IsVisible="{Binding IsCompleted}"
                                                       Foreground="{DynamicResource SuccessBrush}" />
                                            <TextBlock Text="Failed" FontSize="11" FontWeight="SemiBold"
                                                       IsVisible="{Binding IsFailed}"
                                                       Foreground="{DynamicResource ErrorTextBrush}" />
                                        </Panel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20,14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{Binding IsDownloading}"
                           Text="Closing this window keeps the download running in the corner panel." />

                <Button Grid.Column="1"
                        Content="Cancel"
                        Classes="danger"
                        IsVisible="{Binding IsDownloading}"
                        Command="{Binding CancelCommand}" />

                <Button Grid.Column="1"
                        Content="Close"
                        Classes="normal"
                        IsVisible="{Binding IsCompleted}"
                        Click="CloseButton_OnClick" />
            </Grid>
        </Border>

    </Grid>
</Window>
