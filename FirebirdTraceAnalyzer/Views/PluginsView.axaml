<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="600"
             x:Class="FirebirdTraceAnalyzer.Views.PluginsView"
             x:DataType="vm:PluginsViewModel"
             Width="720"
             MaxHeight="640">

    <Design.DataContext>
        <vm:PluginsViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource AppBackgroundBrush}">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Plugins.Title}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Tr Plugins.Subtitle}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="focused" Height="40" Padding="12,0"
                            Command="{Binding InstallCommand}"
                            ToolTip.Tip="{loc:Tr Plugins.InstallTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Svg Width="20" Height="20" Path="{DynamicResource AddIcon}" Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                            <TextBlock Text="{loc:Tr Plugins.Install}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="normal" Height="40" Padding="12,0"
                            Command="{Binding OpenPluginsFolderCommand}"
                            ToolTip.Tip="{loc:Tr Plugins.OpenFolderTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Svg Width="20" Height="20" Path="{DynamicResource FolderIcon}" Css="{DynamicResource ThemeIconStroke}" />
                            <TextBlock Text="{loc:Tr Plugins.OpenFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="danger" Height="40" Padding="14,0"
                            Content="{loc:Tr Plugins.Close}" Command="{Binding CloseCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Restart note -->
        <Border Grid.Row="1"
                Background="{DynamicResource WarningSurfaceBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                IsVisible="{Binding RestartNeeded}">
            <TextBlock Text="{loc:Tr Plugins.RestartNote}"
                       FontSize="12" Foreground="{DynamicResource WarningTextBrush}" />
        </Border>

        <!-- Toolbar: collision filter -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Classes="danger" Height="34" Padding="12,0"
                        Content="{loc:Tr Plugins.ProblemPlug}"
                        Command="{Binding ToggleCollisionsCommand}"
                        IsEnabled="{Binding HasCollisions}"
                        ToolTip.Tip="{loc:Tr Plugins.CollisionTooltip}" />
                <TextBlock VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{Binding ShowCollisions}"
                           Text="{loc:Tr Plugins.CollisionHint}" />
                <TextBlock VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           IsVisible="{Binding !HasCollisions}"
                           Text="{loc:Tr Plugins.NoCollisions}" />
            </StackPanel>
        </Border>

        <!-- Plugins list -->
        <ScrollViewer Grid.Row="3"
                      IsVisible="{Binding !ShowCollisions}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Padding="16" ItemsSource="{Binding Plugins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <!-- Enable toggle (нельзя включить сломанный) -->
                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsEnabled}"
                                          IsEnabled="{Binding !IsLoadError}"
                                          ToolTip.Tip="{loc:Tr Plugins.EnableTooltip}" />

                                <!-- Metadata -->
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock FontSize="11">
                                            <Run Text="{loc:Tr Plugins.LabelAuthor}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            <Run Text="{Binding Author}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11">
                                            <Run Text="{loc:Tr Plugins.LabelVersion}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            <Run Text="{Binding Version}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11">
                                            <Run Text="{loc:Tr Plugins.LabelProvides}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            <Run Text="{Binding KindText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock FontSize="11">
                                        <Run Text="{loc:Tr Plugins.LabelId}" Foreground="{DynamicResource TextMutedBrush}" />
                                        <Run Text="{Binding Id}" Foreground="{DynamicResource TextMutedBrush}" />
                                        <Run Text="  ·  " Foreground="{DynamicResource TextMutedBrush}" />
                                        <Run Text="{Binding DirectoryName}" Foreground="{DynamicResource TextMutedBrush}" />
                                    </TextBlock>
                                    <!-- Status -->
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <!-- Load error detail -->
                                    <TextBlock Text="{Binding LoadError}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ErrorTextBrush}"
                                               IsVisible="{Binding HasLoadError}" />
                                </StackPanel>

                                <!-- Row actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Classes="normal" Height="36" Width="36" Padding="0"
                                            ToolTip.Tip="{loc:Tr Plugins.RevealTooltip}"
                                            Command="{Binding $parent[UserControl].((vm:PluginsViewModel)DataContext).RevealCommand}"
                                            CommandParameter="{Binding}">
                                        <Svg Width="18" Height="18" Path="{DynamicResource FileSearchIcon}" Css="{DynamicResource ThemeIconFill}" />
                                    </Button>
                                    <Button Classes="danger" Height="36" Width="36" Padding="0"
                                            ToolTip.Tip="{loc:Tr Plugins.DeleteTooltip}"
                                            Command="{Binding $parent[UserControl].((vm:PluginsViewModel)DataContext).DeleteCommand}"
                                            CommandParameter="{Binding}">
                                        <Svg Width="18" Height="18" Path="{DynamicResource TrashIcon}" Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state (пусто → коллизий нет, ShowCollisions принудительно false) -->
        <Border Grid.Row="3" Padding="40" IsVisible="{Binding !Plugins.Count}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="420">
                <TextBlock Text="{loc:Tr Plugins.EmptyTitle}"
                           FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:Tr Plugins.EmptyHint}"
                           FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Content="{loc:Tr Plugins.OpenPluginsFolder}" Classes="normal" HorizontalAlignment="Center"
                        Margin="0,6,0,0" Command="{Binding OpenPluginsFolderCommand}" />
            </StackPanel>
        </Border>

        <!-- Collisions: plugins sharing one Id, grouped in pairs/sets -->
        <ScrollViewer Grid.Row="3"
                      IsVisible="{Binding ShowCollisions}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Padding="16" ItemsSource="{Binding CollisionGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CollisionGroupRow">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="12">
                                    <Run Text="{loc:Tr Plugins.IdCollision}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    <Run Text="{Binding Id}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Choices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CollisionChoiceRow">
                                            <RadioButton Margin="0,3"
                                                         GroupName="{Binding $parent[ItemsControl].((vm:CollisionGroupRow)DataContext).GroupName}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                <StackPanel Spacing="2" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock FontSize="11">
                                                        <Run Text="v" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <Run Text="{Binding Version}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <Run Text="{loc:Tr Plugins.AuthorInline}" Foreground="{DynamicResource TextMutedBrush}" />
                                                        <Run Text="{Binding Author}" Foreground="{DynamicResource TextMutedBrush}" />
                                                        <Run Text="  ·  " Foreground="{DynamicResource TextMutedBrush}" />
                                                        <Run Text="{Binding DirectoryName}" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
