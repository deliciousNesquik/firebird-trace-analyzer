<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:views="using:FirebirdTraceAnalyzer.Views"
             xmlns:uc="using:FirebirdTraceAnalyzer.UserControls"
             xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
             x:Class="FirebirdTraceAnalyzer.Views.ReportDesignerView"
             x:DataType="vm:ReportDesignerViewModel"
             Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=uc:DialogHost}, Converter={StaticResource SubtractConverter}, ConverterParameter=48}"
             Height="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=uc:DialogHost}, Converter={StaticResource SubtractConverter}, ConverterParameter=48}">

    <Design.DataContext>
        <vm:ReportDesignerViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Метка поля инспектора -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <!-- Секции инспектора -->
        <Style Selector="Expander">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Expander /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="14,12" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBox Text="{Binding TemplateName}"
                             FontSize="16"
                             FontWeight="SemiBold"
                             BorderThickness="0"
                             Padding="0"
                             Background="Transparent"
                             PlaceholderText="{loc:Tr ReportDesigner.ReportNamePlaceholder}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Preview.AvailableFormats}"
                              SelectedItem="{Binding Preview.SelectedFormat}"
                              MinWidth="120"
                              ToolTip.Tip="{loc:Tr ReportDesigner.FormatUsedByExportTooltip}" />

                    <Button Classes="normal"
                            Padding="12,0"
                            Height="36"
                            Command="{Binding Preview.ExportReportCommand}"
                            ToolTip.Tip="{loc:Tr ReportDesigner.ExportButtonTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Svg Width="16" Height="16" Path="{DynamicResource ExportIcon}" Css="{DynamicResource ThemeIconStroke}" />
                            <TextBlock Text="{loc:Tr ReportDesigner.Export}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="focused"
                            Padding="14,0"
                            Height="36"
                            Content="{loc:Tr ReportDesigner.Save}"
                            Command="{Binding SaveTemplateCommand}"
                            ToolTip.Tip="{loc:Tr ReportDesigner.SaveTemplateTooltip}" />

                    <Button Classes="normal"
                            Padding="12,0"
                            Height="36"
                            Content="{loc:Tr ReportDesigner.Close}"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main: preview (left) + splitter + inspector (right, resizable) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="440" MinWidth="420" MaxWidth="760" />
            </Grid.ColumnDefinitions>

            <!-- Live preview -->
            <views:ReportPreviewView Grid.Column="0" DataContext="{Binding Preview}" />

            <!-- Разделитель: тянем за него, чтобы менять ширину инспектора -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          ResizeDirection="Columns"
                          Background="{DynamicResource BorderBrush}"
                          HorizontalAlignment="Center" />

            <!-- Inspector -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}">
                <ScrollViewer>
                    <!-- Отступы задаём Margin'ом контента (не Padding'ом ScrollViewer): нижний
                         Padding ScrollViewer не входит в область прокрутки, из-за чего последняя
                         секция обрезалась. Margin контента входит в extent и прокручивается целиком. -->
                    <StackPanel Margin="14,14,14,32">

                        <!-- Template -->
                        <Expander Header="{loc:Tr ReportDesigner.TemplateSection}" IsExpanded="True">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.ReportNameLabel}" />
                                    <TextBox Text="{Binding TemplateName}"
                                             PlaceholderText="{loc:Tr ReportDesigner.EnterReportNamePlaceholder}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.Description}" />
                                    <TextBox Text="{Binding TemplateDescription}"
                                             PlaceholderText="{loc:Tr ReportDesigner.OptionalDescriptionPlaceholder}"
                                             AcceptsReturn="True"
                                             Height="56" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Header -->
                        <Expander Header="{loc:Tr ReportDesigner.HeaderSection}" IsExpanded="True">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.TitleLabel}" />
                                    <TextBox Text="{Binding ReportTitle}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.Subtitle}" />
                                    <TextBox Text="{Binding ReportSubtitle}" PlaceholderText="{loc:Tr ReportDesigner.OptionalPlaceholder}" />
                                </StackPanel>
                                <CheckBox Content="{loc:Tr ReportDesigner.ShowGeneratedDate}" IsChecked="{Binding ShowGeneratedDate}" />

                                <Separator />
                                <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.HeaderVariables}" />
                                <ItemsControl ItemsSource="{Binding AvailableVariables}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="10,0" />
                                                <NumericUpDown Grid.Column="2"
                                                               Value="{Binding DisplayOrder}"
                                                               Minimum="1" Maximum="100" Width="76"
                                                               ShowButtonSpinner="False"
                                                               IsEnabled="{Binding IsVisible}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Columns -->
                        <Expander Header="{loc:Tr ReportDesigner.ColumnsSection}" IsExpanded="True">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.EventLimit}" />
                                    <NumericUpDown Value="{Binding EventLimit}"
                                                   Minimum="1" Maximum="10000"
                                                   PlaceholderText="{loc:Tr ReportDesigner.NoLimitPlaceholder}"
                                                   AllowSpin="True" Increment="5" />
                                </StackPanel>

                                <CheckBox Content="{loc:Tr ReportDesigner.ShowSummaryStatistics}" IsChecked="{Binding ShowSummary}" />

                                <Separator />

                                <!-- Палитра доступных полей: «+» добавляет колонку (можно несколько раз). -->
                                <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.AddColumns}" />
                                <ItemsControl ItemsSource="{Binding AvailableFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Classes="normal" Width="28" Height="28" Padding="0"
                                                        FontSize="16" Content="+"
                                                        ToolTip.Tip="{loc:Tr ReportDesigner.AddFieldTooltip}"
                                                        Command="{Binding $parent[UserControl].((vm:ReportDesignerViewModel)DataContext).AddColumnCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator />

                                <!-- Колонки отчёта: дубли разрешены; у каждой имя/роль/агрегат/формат/ширина/порядок и «−». -->
                                <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.ReportColumnsLabel}" />
                                <TextBlock Text="{loc:Tr ReportDesigner.ColumnsRoleHint}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />

                                <TextBlock Text="{loc:Tr ReportDesigner.NoColumnsYet}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsVisible="{Binding !ReportColumns.Count}" />

                                <ItemsControl ItemsSource="{Binding ReportColumns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                                <StackPanel Spacing="6">
                                                    <!-- Имя колонки (редактируемое) + удаление -->
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <TextBox Grid.Column="0" Text="{Binding DisplayName}" FontSize="12"
                                                                 ToolTip.Tip="{loc:Tr ReportDesigner.ColumnHeaderTooltip}" />
                                                        <Button Grid.Column="1" Classes="danger" Width="28" Height="28" Padding="0"
                                                                FontSize="16" Content="−"
                                                                ToolTip.Tip="{loc:Tr ReportDesigner.RemoveColumnTooltip}"
                                                                Command="{Binding $parent[UserControl].((vm:ReportDesignerViewModel)DataContext).RemoveColumnCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                    <!-- Роль · Формат · Ширина% · Порядок -->
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="5">
                                                        <ComboBox Grid.Column="0" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}"
                                                                  FontSize="11" Width="84" ToolTip.Tip="{loc:Tr ReportDesigner.RoleTooltip}" />
                                                        <TextBox Grid.Column="1" Text="{Binding Format}" PlaceholderText="{loc:Tr ReportDesigner.FormatPlaceholder}"
                                                                 FontSize="11" Width="50" ToolTip.Tip="{loc:Tr ReportDesigner.FormatTooltip}" />
                                                        <NumericUpDown Grid.Column="2" Value="{Binding WidthPercent}" Minimum="5" Maximum="100"
                                                                       PlaceholderText="{loc:Tr ReportDesigner.WidthPercentPlaceholder}" ShowButtonSpinner="False" FontSize="11" Width="54"
                                                                       ToolTip.Tip="{loc:Tr ReportDesigner.WidthPercentTooltip}" />
                                                        <NumericUpDown Grid.Column="3" Value="{Binding Order}" Minimum="1" Maximum="100"
                                                                       PlaceholderText="{loc:Tr ReportDesigner.OrderPlaceholder}" ShowButtonSpinner="False" FontSize="11" Width="54"
                                                                       ToolTip.Tip="{loc:Tr ReportDesigner.OrderTooltip}" />
                                                    </Grid>
                                                    <!-- Функция агрегации (только для роли Aggregate) -->
                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6"
                                                          IsVisible="{Binding IsAggregate}">
                                                        <TextBlock Grid.Column="0" Text="{loc:Tr ReportDesigner.Func}" VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AggregateOptions}" SelectedItem="{Binding Aggregate}"
                                                                  FontSize="11" Width="120" ToolTip.Tip="{loc:Tr ReportDesigner.AggregateFunctionTooltip}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Grouping & sort -->
                        <Expander Header="{loc:Tr ReportDesigner.GroupingAndSortSection}">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="6" IsVisible="{Binding !IsGrouped}">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.SortBy}" />
                                    <ComboBox ItemsSource="{Binding AvailableSorts}"
                                              SelectedItem="{Binding SelectedSort}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Content="{loc:Tr ReportDesigner.Descending}"
                                              IsChecked="{Binding SortDescending}"
                                              IsEnabled="{Binding SelectedSort, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>

                                <StackPanel Spacing="6" IsVisible="{Binding IsGrouped}">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.SortGroupedResultByColumn}" />
                                    <ComboBox ItemsSource="{Binding SortableColumns}"
                                              SelectedItem="{Binding SelectedSortColumn}"
                                              PlaceholderText="{loc:Tr ReportDesigner.GroupOrderPlaceholder}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Content="{loc:Tr ReportDesigner.Descending}"
                                              IsChecked="{Binding SortDescending}"
                                              IsEnabled="{Binding SelectedSortColumn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Filters -->
                        <Expander Header="{loc:Tr ReportDesigner.FiltersSection}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{loc:Tr ReportDesigner.ActiveFilters}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{loc:Tr ReportDesigner.Reset}" Classes="danger" Padding="10,4"
                                            Command="{Binding FiltersPanel.ResetAllFiltersCommand}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding FiltersPanel.FiltersByCategory}"
                                              IsVisible="{Binding FiltersPanel.FiltersByCategory.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,10">
                                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsActive}"
                                                                              FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    <StackPanel IsVisible="{Binding IsActive}" Margin="26,6,0,0">
                                                                        <TextBox PlaceholderText="{loc:Tr ReportDesigner.TypeToFindPlaceholder}"
                                                                                 Text="{Binding ValueSearchText, Mode=TwoWay}"
                                                                                 IsVisible="{Binding AvailableValues.Count, Converter={StaticResource CountToVisibilityConverter}}"
                                                                                 Margin="0,0,0,6" />
                                                                        <ItemsControl ItemsSource="{Binding FilteredValues}" MaxHeight="180"
                                                                                      IsVisible="{Binding FilteredValues.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <VirtualizingStackPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox Margin="0,3" IsThreeState="True"
                                                                                              ToolTip.Tip="{loc:Tr ReportDesigner.FilterValueTooltip}"
                                                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                                                        <CheckBox.Content>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                                <TextBlock Text="{Binding DisplayName}" />
                                                                                                <TextBlock Text="{Binding Count, StringFormat='({0})'}"
                                                                                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                                                                                <TextBlock Text="{loc:Tr ReportDesigner.Excluded}" FontSize="10" VerticalAlignment="Center"
                                                                                                           Foreground="{DynamicResource ErrorTextBrush}"
                                                                                                           IsVisible="{Binding IsExcluded}" />
                                                                                            </StackPanel>
                                                                                        </CheckBox.Content>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <StackPanel Spacing="6" Margin="0,4,0,0"
                                                                                    IsVisible="{Binding MinValue, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                                                                                <TextBlock Grid.Column="0" Text="{loc:Tr ReportDesigner.From}" VerticalAlignment="Center" FontSize="11" />
                                                                                <TextBox Grid.Column="1" FontSize="11" Padding="6,4" Text="{Binding CurrentMinValue, Mode=TwoWay}" />
                                                                                <TextBlock Grid.Column="2" Text="{loc:Tr ReportDesigner.To}" VerticalAlignment="Center" FontSize="11" />
                                                                                <TextBox Grid.Column="3" FontSize="11" Padding="6,4" Text="{Binding CurrentMaxValue, Mode=TwoWay}" />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                <TextBlock Text="{loc:Tr ReportDesigner.NoAvailableFilters}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsVisible="{Binding !FiltersPanel.FiltersByCategory.Count}" />

                                <Button Content="{loc:Tr ReportDesigner.ApplyFilters}" Classes="focused"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding FiltersPanel.ApplyFiltersCommand}" />
                            </StackPanel>
                        </Expander>

                        <!-- Export -->
                        <Expander Header="{loc:Tr ReportDesigner.ExportSection}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.SupportedFormats}" />
                                <ItemsControl ItemsSource="{Binding SupportedFormats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Format}" IsChecked="{Binding IsSupported}" Margin="0,0,14,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Tr ReportDesigner.DefaultFormat}" />
                                    <ComboBox ItemsSource="{Binding Preview.AvailableFormats}"
                                              SelectedItem="{Binding DefaultFormat}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="●" Foreground="{DynamicResource WarningTextBrush}" FontSize="14"
                           IsVisible="{Binding HasUnsavedChanges}" />
                <TextBlock Text="{loc:Tr ReportDesigner.UnsavedChanges}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           IsVisible="{Binding HasUnsavedChanges}" />
                <TextBlock Text="{loc:Tr ReportDesigner.LivePreviewHint}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"
                           IsVisible="{Binding !HasUnsavedChanges}" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
