<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:views="using:FirebirdTraceAnalyzer.Views"
             xmlns:uc="using:FirebirdTraceAnalyzer.UserControls"
             xmlns:enums="using:FirebirdTraceAnalyzer.Enums.Reports"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
             x:Class="FirebirdTraceAnalyzer.Views.ReportDesignerView"
             x:DataType="vm:ReportDesignerViewModel"
             Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=uc:DialogHost}, Converter={StaticResource SubtractConverter}, ConverterParameter=48}"
             Height="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=uc:DialogHost}, Converter={StaticResource SubtractConverter}, ConverterParameter=48}">

    <Design.DataContext>
        <vm:ReportDesignerViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Метка поля инспектора -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <!-- Секции инспектора -->
        <Style Selector="Expander">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Expander /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="14,12" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBox Text="{Binding TemplateName}"
                             FontSize="16"
                             FontWeight="SemiBold"
                             BorderThickness="0"
                             Padding="0"
                             Background="Transparent"
                             PlaceholderText="Report name" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Preview.AvailableFormats}"
                              SelectedItem="{Binding Preview.SelectedFormat}"
                              MinWidth="120"
                              ToolTip.Tip="Format used by Export" />

                    <Button Classes="normal"
                            Padding="12,0"
                            Height="36"
                            Command="{Binding Preview.ExportReportCommand}"
                            ToolTip.Tip="Generate and open the report file">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Svg Width="16" Height="16" Path="{DynamicResource ExportIcon}" Css="{DynamicResource ThemeIconStroke}" />
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="focused"
                            Padding="14,0"
                            Height="36"
                            Content="Save"
                            Command="{Binding SaveTemplateCommand}"
                            ToolTip.Tip="Save this template" />

                    <Button Classes="normal"
                            Padding="12,0"
                            Height="36"
                            Content="Close"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main: preview (left) + splitter + inspector (right, resizable) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="440" MinWidth="420" MaxWidth="760" />
            </Grid.ColumnDefinitions>

            <!-- Live preview -->
            <views:ReportPreviewView Grid.Column="0" DataContext="{Binding Preview}" />

            <!-- Разделитель: тянем за него, чтобы менять ширину инспектора -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          ResizeDirection="Columns"
                          Background="{DynamicResource BorderBrush}"
                          HorizontalAlignment="Center" />

            <!-- Inspector -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}">
                <ScrollViewer>
                    <!-- Отступы задаём Margin'ом контента (не Padding'ом ScrollViewer): нижний
                         Padding ScrollViewer не входит в область прокрутки, из-за чего последняя
                         секция обрезалась. Margin контента входит в extent и прокручивается целиком. -->
                    <StackPanel Margin="14,14,14,32">

                        <!-- Template -->
                        <Expander Header="Template" IsExpanded="True">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="Report name *" />
                                    <TextBox Text="{Binding TemplateName}"
                                             PlaceholderText="Enter report name..." />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="Category" />
                                    <ComboBox SelectedValue="{Binding Category}"
                                              SelectedValueBinding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Quick Report" Tag="{x:Static enums:ReportCategory.Quick}" />
                                        <ComboBoxItem Content="Custom Report" Tag="{x:Static enums:ReportCategory.Custom}" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="Description" />
                                    <TextBox Text="{Binding TemplateDescription}"
                                             PlaceholderText="Optional description..."
                                             AcceptsReturn="True"
                                             Height="56" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Header -->
                        <Expander Header="Header" IsExpanded="True">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="Title *" />
                                    <TextBox Text="{Binding ReportTitle}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="Subtitle" />
                                    <TextBox Text="{Binding ReportSubtitle}" PlaceholderText="Optional..." />
                                </StackPanel>
                                <CheckBox Content="Show generated date" IsChecked="{Binding ShowGeneratedDate}" />

                                <Separator />
                                <TextBlock Classes="fieldLabel" Text="Header variables" />
                                <ItemsControl ItemsSource="{Binding AvailableVariables}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="10,0" />
                                                <NumericUpDown Grid.Column="2"
                                                               Value="{Binding DisplayOrder}"
                                                               Minimum="1" Maximum="100" Width="76"
                                                               ShowButtonSpinner="False"
                                                               IsEnabled="{Binding IsVisible}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Columns -->
                        <Expander Header="Columns" IsExpanded="True">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="Display style" />
                                        <ComboBox SelectedValue="{Binding DisplayStyle}"
                                                  SelectedValueBinding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Table" Tag="{x:Static enums:EventDisplayStyle.Table}" />
                                            <ComboBoxItem Content="Detailed List" Tag="{x:Static enums:EventDisplayStyle.DetailedList}" />
                                            <ComboBoxItem Content="Compact" Tag="{x:Static enums:EventDisplayStyle.Compact}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="Event limit" />
                                        <NumericUpDown Value="{Binding EventLimit}"
                                                       Minimum="1" Maximum="10000"
                                                       PlaceholderText="No limit"
                                                       AllowSpin="True" Increment="5" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Show summary statistics" IsChecked="{Binding ShowSummary}" />

                                <Separator />

                                <!-- Палитра доступных полей: «+» добавляет колонку (можно несколько раз). -->
                                <TextBlock Classes="fieldLabel" Text="Add columns" />
                                <ItemsControl ItemsSource="{Binding AvailableFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Classes="normal" Width="28" Height="28" Padding="0"
                                                        FontSize="16" Content="+"
                                                        ToolTip.Tip="Add this field as a report column"
                                                        Command="{Binding $parent[UserControl].((vm:ReportDesignerViewModel)DataContext).AddColumnCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator />

                                <!-- Колонки отчёта: дубли разрешены; у каждой имя/роль/агрегат/формат/ширина/порядок и «−». -->
                                <TextBlock Classes="fieldLabel" Text="Report columns *" />
                                <TextBlock Text="Role: Field = plain column · Group key = group rows · Aggregate = Count/Sum/… per group. One field can be added several times."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />

                                <TextBlock Text="No columns yet — add fields above with +."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsVisible="{Binding !ReportColumns.Count}" />

                                <ItemsControl ItemsSource="{Binding ReportColumns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                                <StackPanel Spacing="6">
                                                    <!-- Имя колонки (редактируемое) + удаление -->
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <TextBox Grid.Column="0" Text="{Binding DisplayName}" FontSize="12"
                                                                 ToolTip.Tip="Column header" />
                                                        <Button Grid.Column="1" Classes="danger" Width="28" Height="28" Padding="0"
                                                                FontSize="16" Content="−"
                                                                ToolTip.Tip="Remove column"
                                                                Command="{Binding $parent[UserControl].((vm:ReportDesignerViewModel)DataContext).RemoveColumnCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                    <!-- Роль · Формат · Ширина% · Порядок -->
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="5">
                                                        <ComboBox Grid.Column="0" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}"
                                                                  FontSize="11" Width="84" ToolTip.Tip="Role: Field / Group key / Aggregate" />
                                                        <TextBox Grid.Column="1" Text="{Binding Format}" PlaceholderText="Fmt"
                                                                 FontSize="11" Width="50" ToolTip.Tip="Format, e.g. N0 or {}{0:N0} ms" />
                                                        <NumericUpDown Grid.Column="2" Value="{Binding WidthPercent}" Minimum="5" Maximum="100"
                                                                       PlaceholderText="W%" ShowButtonSpinner="False" FontSize="11" Width="54"
                                                                       ToolTip.Tip="Width %" />
                                                        <NumericUpDown Grid.Column="3" Value="{Binding Order}" Minimum="1" Maximum="100"
                                                                       PlaceholderText="Ord" ShowButtonSpinner="False" FontSize="11" Width="54"
                                                                       ToolTip.Tip="Order" />
                                                    </Grid>
                                                    <!-- Функция агрегации (только для роли Aggregate) -->
                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6"
                                                          IsVisible="{Binding IsAggregate}">
                                                        <TextBlock Grid.Column="0" Text="Func" VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AggregateOptions}" SelectedItem="{Binding Aggregate}"
                                                                  FontSize="11" Width="120" ToolTip.Tip="Aggregate function" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Grouping & sort -->
                        <Expander Header="Grouping &amp; sort">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="6" IsVisible="{Binding !IsGrouped}">
                                    <TextBlock Classes="fieldLabel" Text="Sort by" />
                                    <ComboBox ItemsSource="{Binding AvailableSorts}"
                                              SelectedItem="{Binding SelectedSort}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Content="Descending"
                                              IsChecked="{Binding SortDescending}"
                                              IsEnabled="{Binding SelectedSort, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>

                                <StackPanel Spacing="6" IsVisible="{Binding IsGrouped}">
                                    <TextBlock Classes="fieldLabel" Text="Sort grouped result by column" />
                                    <ComboBox ItemsSource="{Binding SortableColumns}"
                                              SelectedItem="{Binding SelectedSortColumn}"
                                              PlaceholderText="Group order"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Content="Descending"
                                              IsChecked="{Binding SortDescending}"
                                              IsEnabled="{Binding SelectedSortColumn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Filters -->
                        <Expander Header="Filters">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Active filters" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Reset" Classes="danger" Padding="10,4"
                                            Command="{Binding FiltersPanel.ResetAllFiltersCommand}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding FiltersPanel.FiltersByCategory}"
                                              IsVisible="{Binding FiltersPanel.FiltersByCategory.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,10">
                                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsActive}"
                                                                              FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    <StackPanel IsVisible="{Binding IsActive}" Margin="26,6,0,0">
                                                                        <TextBox PlaceholderText="Type to find..."
                                                                                 Text="{Binding ValueSearchText, Mode=TwoWay}"
                                                                                 IsVisible="{Binding AvailableValues.Count, Converter={StaticResource CountToVisibilityConverter}}"
                                                                                 Margin="0,0,0,6" />
                                                                        <ItemsControl ItemsSource="{Binding FilteredValues}" MaxHeight="180"
                                                                                      IsVisible="{Binding FilteredValues.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <VirtualizingStackPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox Margin="0,3" IsThreeState="True"
                                                                                              ToolTip.Tip="Unselected → included → excluded"
                                                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                                                        <CheckBox.Content>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                                <TextBlock Text="{Binding DisplayName}" />
                                                                                                <TextBlock Text="{Binding Count, StringFormat='({0})'}"
                                                                                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                                                                                <TextBlock Text="excluded" FontSize="10" VerticalAlignment="Center"
                                                                                                           Foreground="{DynamicResource ErrorTextBrush}"
                                                                                                           IsVisible="{Binding IsExcluded}" />
                                                                                            </StackPanel>
                                                                                        </CheckBox.Content>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <StackPanel Spacing="6" Margin="0,4,0,0"
                                                                                    IsVisible="{Binding MinValue, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                                                                                <TextBlock Grid.Column="0" Text="From" VerticalAlignment="Center" FontSize="11" />
                                                                                <TextBox Grid.Column="1" FontSize="11" Padding="6,4" Text="{Binding CurrentMinValue, Mode=TwoWay}" />
                                                                                <TextBlock Grid.Column="2" Text="To" VerticalAlignment="Center" FontSize="11" />
                                                                                <TextBox Grid.Column="3" FontSize="11" Padding="6,4" Text="{Binding CurrentMaxValue, Mode=TwoWay}" />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                <TextBlock Text="No available filters"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsVisible="{Binding !FiltersPanel.FiltersByCategory.Count}" />

                                <Button Content="Apply filters" Classes="focused"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding FiltersPanel.ApplyFiltersCommand}" />
                            </StackPanel>
                        </Expander>

                        <!-- Export -->
                        <Expander Header="Export">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="fieldLabel" Text="Supported formats" />
                                <ItemsControl ItemsSource="{Binding SupportedFormats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Format}" IsChecked="{Binding IsSupported}" Margin="0,0,14,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="Default format" />
                                    <ComboBox SelectedValue="{Binding DefaultFormat}"
                                              SelectedValueBinding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="PDF" Tag="{x:Static enums:ReportFormat.PDF}" />
                                        <ComboBoxItem Content="Word (DOCX)" Tag="{x:Static enums:ReportFormat.DOCX}" />
                                        <ComboBoxItem Content="Excel (XLSX)" Tag="{x:Static enums:ReportFormat.XLSX}" />
                                        <ComboBoxItem Content="CSV" Tag="{x:Static enums:ReportFormat.CSV}" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="●" Foreground="{DynamicResource WarningTextBrush}" FontSize="14"
                           IsVisible="{Binding HasUnsavedChanges}" />
                <TextBlock Text="Unsaved changes"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           IsVisible="{Binding HasUnsavedChanges}" />
                <TextBlock Text="Live preview updates as you edit · changes match the exported file"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"
                           IsVisible="{Binding !HasUnsavedChanges}" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
