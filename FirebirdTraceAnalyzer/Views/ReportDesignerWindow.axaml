<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enums="using:FirebirdTraceAnalyzer.Enums.Reports"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="FirebirdTraceAnalyzer.Views.ReportDesignerWindow"
        x:DataType="vm:ReportDesignerViewModel"
        Title="Report Designer"
        Width="1200"
        Height="800"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:ReportDesignerViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Report Designer"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Height="40" Width="40" Command="{Binding SaveTemplateCommand}"
                            Classes="focused" ToolTip.Tip="Save custom report">
                        <Button.Content>
                            <Svg Width="40"
                                 Path="{DynamicResource SaveIcon}"
                                 Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                        </Button.Content>
                    </Button>
                    
                    <Button Height="40" Width="40" Classes="normal" Command="{Binding GeneratePreviewCommand}" ToolTip.Tip="Open preview window with current data">
                        <Button.Content>
                            <Svg Width="40"
                                 Path="{DynamicResource PreviewIcon}"
                                 Css="{DynamicResource ThemeIconFill}" />
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" >
            <StackPanel Spacing="20" Margin="20">

                <!-- Template Info -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    
                    <StackPanel Spacing="12">
                        <TextBlock Text="Template Information"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Template Name *" FontSize="12" />
                                <TextBox Text="{Binding TemplateName}"
                                         PlaceholderText="Enter template name..." />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Category" FontSize="12" />
                                
                                <ComboBox SelectedValue="{Binding Category}"
                                          SelectedValueBinding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Quick Report" Tag="{x:Static enums:ReportCategory.Quick}" />
                                    <ComboBoxItem Content="Custom Report" Tag="{x:Static enums:ReportCategory.Custom}" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                <TextBlock Text="Description" FontSize="12" />
                                <TextBox Text="{Binding TemplateDescription}"
                                         PlaceholderText="Enter description..."
                                         AcceptsReturn="True"
                                         Height="60" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Header Settings -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    
                    <StackPanel Spacing="12">
                        <TextBlock Text="Header Settings"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Report Title *" FontSize="12" />
                                <TextBox Text="{Binding ReportTitle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Subtitle" FontSize="12" />
                                <TextBox Text="{Binding ReportSubtitle}"
                                         PlaceholderText="Optional..." />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8" Orientation="Horizontal">
                                <CheckBox Content="Show Logo"
                                          IsEnabled="False"
                                          IsChecked="{Binding ShowLogo}" />
                                <CheckBox Content="Show Generated Date"
                                          IsChecked="{Binding ShowGeneratedDate}" />
                            </StackPanel>
                        </Grid>

                        <Separator />

                        <TextBlock Text="Header Variables" FontWeight="Medium" FontSize="12" />
                        
                        <ScrollViewer MaxHeight="200">
                            <ItemsControl ItemsSource="{Binding AvailableVariables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsVisible}"
                                                          VerticalAlignment="Center" />
                                                
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0" />
                                                
                                                <NumericUpDown Grid.Column="2"
                                                               Value="{Binding DisplayOrder}"
                                                               Minimum="1"
                                                               Maximum="100"
                                                               Width="80"
                                                               ShowButtonSpinner="False"
                                                               IsEnabled="{Binding IsVisible}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Body Settings -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    
                    <StackPanel Spacing="12">
                        <TextBlock Text="Body Settings"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Display Style" FontSize="12" />
                                
                                <ComboBox SelectedValue="{Binding DisplayStyle}"
                                          SelectedValueBinding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Table" Tag="{x:Static enums:EventDisplayStyle.Table}" />
                                    <ComboBoxItem Content="Detailed List" Tag="{x:Static enums:EventDisplayStyle.DetailedList}" />
                                    <ComboBoxItem Content="Compact" Tag="{x:Static enums:EventDisplayStyle.Compact}" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Event Limit" FontSize="12" />
                                <NumericUpDown Value="{Binding EventLimit}"
                                               Minimum="1"
                                               Maximum="10000"
                                               PlaceholderText="No limit..."
                                               AllowSpin="True"
                                               Increment="5" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Bottom">
                                <CheckBox Content="Show Summary Statistics"
                                          IsChecked="{Binding ShowSummary}" />
                            </StackPanel>
                        </Grid>

                        <Separator />

                        <TextBlock Text="Visible Event Fields *" FontWeight="Medium" FontSize="12" />

                        <TextBlock Text="Role: Field = plain column. Group key = group rows by this column. Aggregate = compute Count/Sum/… over the group."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <ScrollViewer MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding AvailableFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1">

                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*,100,80,80">
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsVisible}"
                                                              VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayName}"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0" />

                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding Format}"
                                                             PlaceholderText="Format..."
                                                             FontSize="11"
                                                             IsEnabled="{Binding IsVisible}" />

                                                    <NumericUpDown Grid.Column="3"
                                                                   Value="{Binding WidthPercent}"
                                                                   Minimum="5"
                                                                   Maximum="100"
                                                                   PlaceholderText="Width%"
                                                                   ShowButtonSpinner="False"
                                                                   FontSize="11"
                                                                   IsEnabled="{Binding IsVisible}" />

                                                    <NumericUpDown Grid.Column="4"
                                                                   Value="{Binding Order}"
                                                                   Minimum="1"
                                                                   Maximum="100"
                                                                   ShowButtonSpinner="False"
                                                                   FontSize="11"
                                                                   IsEnabled="{Binding IsVisible}" />
                                                </Grid>

                                                <!-- Роль колонки и функция агрегации (видны только для выбранного поля) -->
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8"
                                                            Margin="28,0,0,0"
                                                            IsVisible="{Binding IsVisible}">
                                                    <TextBlock Text="Role:"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <ComboBox ItemsSource="{Binding KindOptions}"
                                                              SelectedItem="{Binding Kind}"
                                                              FontSize="11"
                                                              MinWidth="110" />

                                                    <TextBlock Text="Func:"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               IsVisible="{Binding IsAggregate}" />
                                                    <ComboBox ItemsSource="{Binding AggregateOptions}"
                                                              SelectedItem="{Binding Aggregate}"
                                                              FontSize="11"
                                                              MinWidth="120"
                                                              IsVisible="{Binding IsAggregate}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Filters & Sorting -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    
                    <StackPanel Spacing="12">
                        <TextBlock Text="Filters And Sorting"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <!-- Сортировка событий (для негруппированного отчёта) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                              IsVisible="{Binding !IsGrouped}">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Sort By" FontSize="12" />
                                <ComboBox ItemsSource="{Binding AvailableSorts}"
                                          SelectedItem="{Binding SelectedSort}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom">
                                <CheckBox Content="Descending Order"
                                          IsChecked="{Binding SortDescending}"
                                          IsEnabled="{Binding SelectedSort, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Сортировка сгруппированного результата по колонке (вкл. агрегаты) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                              IsVisible="{Binding IsGrouped}">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Sort result by (column)" FontSize="12" />
                                <ComboBox ItemsSource="{Binding SortableColumns}"
                                          SelectedItem="{Binding SelectedSortColumn}"
                                          PlaceholderText="Group order"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom">
                                <CheckBox Content="Descending Order"
                                          IsChecked="{Binding SortDescending}"
                                          IsEnabled="{Binding SelectedSortColumn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Grid>

                        <Separator />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Active Filters"
                                       FontWeight="Medium"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Reset Filters"
                                    Classes="danger"
                                    Padding="10,4"
                                    Command="{Binding FiltersPanel.ResetAllFiltersCommand}" />
                        </Grid>

                        <!-- Тот же фильтр, что и на главной форме: группировка по категориям,
                             выбор значений (чекбоксы со счётчиками) и диапазоны. -->
                        <ScrollViewer MaxHeight="320"
                                      IsVisible="{Binding FiltersPanel.FiltersByCategory.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ItemsControl ItemsSource="{Binding FiltersPanel.FiltersByCategory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">

                                            <TextBlock Text="{Binding Key}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,0,0,8" />

                                            <ItemsControl ItemsSource="{Binding}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,12">

                                                            <CheckBox Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsActive}"
                                                                      FontWeight="Medium"
                                                                      Foreground="{DynamicResource TextPrimaryBrush}" />

                                                            <StackPanel IsVisible="{Binding IsActive}"
                                                                        Margin="28,8,0,0">

                                                                <TextBox PlaceholderText="Type to find filter..."
                                                                         Text="{Binding ValueSearchText, Mode=TwoWay}"
                                                                         IsVisible="{Binding AvailableValues.Count, Converter={StaticResource CountToVisibilityConverter}}"
                                                                         Margin="0,0,0,8" />

                                                                <ItemsControl ItemsSource="{Binding FilteredValues}"
                                                                              MaxHeight="200"
                                                                              IsVisible="{Binding FilteredValues.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <VirtualizingStackPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox Margin="0,4"
                                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                                <CheckBox.Content>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                        <TextBlock Text="{Binding DisplayName}" />
                                                                                        <TextBlock Text="{Binding Count, StringFormat='({0})'}"
                                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                                   FontSize="11" />
                                                                                    </StackPanel>
                                                                                </CheckBox.Content>
                                                                            </CheckBox>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <StackPanel Spacing="8"
                                                                            Margin="0,4,0,0"
                                                                            IsVisible="{Binding MinValue, Converter={x:Static ObjectConverters.IsNotNull}}">

                                                                    <TextBlock Text="Range:"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" />

                                                                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                                                        <TextBlock Grid.Column="0" Text="From:" VerticalAlignment="Center" FontSize="11" />
                                                                        <TextBox Grid.Column="1" FontSize="11" Padding="6,4"
                                                                                 Text="{Binding CurrentMinValue, Mode=TwoWay}" />
                                                                        <TextBlock Grid.Column="2" Text="To:" VerticalAlignment="Center" FontSize="11" />
                                                                        <TextBox Grid.Column="3" FontSize="11" Padding="6,4"
                                                                                 Text="{Binding CurrentMaxValue, Mode=TwoWay}" />
                                                                    </Grid>

                                                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                                                        <Run Text="Min:" />
                                                                        <Run Text="{Binding MinValue}" />
                                                                        <Run Text=" | Max:" />
                                                                        <Run Text="{Binding MaxValue}" />
                                                                    </TextBlock>
                                                                </StackPanel>

                                                            </StackPanel>

                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="No available filters"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsVisible="{Binding !FiltersPanel.FiltersByCategory.Count}"
                                   Margin="0,4" />

                        <Button Content="Apply Filters"
                                Classes="focused"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0,4,0,0"
                                
                                Command="{Binding FiltersPanel.ApplyFiltersCommand}" />
                    </StackPanel>
                </Border>

                <!-- Export Formats -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    
                    <StackPanel Spacing="12">
                        <TextBlock Text="Export Formats"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="Supported Formats" FontSize="12" />
                                
                                <ItemsControl ItemsSource="{Binding SupportedFormats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Format}"
                                                      IsChecked="{Binding IsSupported}"
                                                      Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Default Format" FontSize="12" />
                                <ComboBox SelectedValue="{Binding DefaultFormat}" 
                                          SelectedValueBinding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="PDF" Tag="{x:Static enums:ReportFormat.PDF}" />
                                    <ComboBoxItem Content="Word (DOCX)" Tag="{x:Static enums:ReportFormat.DOCX}" />
                                    <ComboBoxItem Content="Excel (XLSX)" Tag="{x:Static enums:ReportFormat.XLSX}" />
                                    <ComboBoxItem Content="CSV" Tag="{x:Static enums:ReportFormat.CSV}" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="●"
                               Foreground="{DynamicResource WarningTextBrush}"
                               FontSize="16"
                               IsVisible="{Binding HasUnsavedChanges}" />
                    <TextBlock Text="Unsaved changes"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsVisible="{Binding HasUnsavedChanges}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                    <Button Content="Save And Close"
                            Classes="focused"
                            Command="{Binding SaveTemplateCommand}"/>
                
                    <Button Content="Cancel"
                            Classes="danger"
                            Click="CancelButton_OnClick"/>    
                </StackPanel>
                
            </Grid>
        </Border>

    </Grid>
</Window>