<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="640"
             x:Class="FirebirdTraceAnalyzer.Views.SettingsWindowView"
             x:DataType="vm:SettingsWindowViewModel"
             Width="640"
             MaxHeight="720">

    <Design.DataContext>
        <vm:SettingsWindowViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Строка настройки: слева название+описание, справа редактор значения.
             ColumnDefinitions задаётся инлайн на каждом Grid (через Style для коллекции
             ColumnDefinitions в Avalonia работает ненадёжно). -->
        <Style Selector="Grid.settingRow">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style Selector="Grid.settingRow > StackPanel.label">
            <Setter Property="Spacing" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style Selector="Grid.settingRow > StackPanel.label > TextBlock.title">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Grid.settingRow > StackPanel.label > TextBlock.desc">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="5">
                    <TextBlock Text="{loc:Tr Settings.Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Tr Settings.Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                    <Button Height="40"
                            Classes="normal"
                            ToolTip.Tip="{loc:Tr Settings.Import.Tip}"
                            Command="{Binding ImportCommand}">

                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Svg Width="20" Height="20" Path="{DynamicResource ImportIcon}" Css="{DynamicResource ThemeIconStroke}" />
                            <TextBlock Text="{loc:Tr Settings.Import}" />
                        </StackPanel>

                    </Button>

                    <Button Height="40"
                            Classes="normal"
                            Command="{Binding ExportCommand}"
                            ToolTip.Tip="{loc:Tr Settings.Export.Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Svg Height="20" Path="{DynamicResource ExportIcon}" Css="{DynamicResource ThemeIconStroke}" />
                            <TextBlock Text="{loc:Tr Settings.Export}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20" Spacing="4">

                <!-- General -->
                <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings.Section.General}" />

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.SearchMode}" />
                        <TextBlock Classes="desc"
                                   Text="{loc:Tr Settings.SearchMode.Desc}" />
                    </StackPanel>
                    <!-- Сегмент из двух кнопок: слева Classic, справа Regex. Клик всегда выставляет
                         нужный режим (Command), IsChecked отражает состояние в одну сторону. -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="{loc:Tr Settings.Search.Classic}"
                                      MinWidth="84"
                                        CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding IsClassicSearch, Mode=OneWay}"
                                      Command="{Binding SelectClassicCommand}" />
                        <ToggleButton Content="{loc:Tr Settings.Search.Regex}"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding IsRegexSearch, Mode=OneWay}"
                                      Command="{Binding SelectRegexCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.Theme}" />
                        <TextBlock Classes="desc"
                                   Text="{loc:Tr Settings.Theme.Desc}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding Theme}" />
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.Language}" />
                        <TextBlock Classes="desc"
                                   Text="{loc:Tr Settings.Language.Desc}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="loc:LanguageOption">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Separator Margin="0,6,0,16" />

                <!-- Advanced -->
                <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings.Section.Advanced}" />

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Grid.Column="0" Classes="label">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="title" Text="{loc:Tr Settings.DeveloperMode}" />
                            <Border Background="{DynamicResource WarningSurfaceBrush}"
                                    BorderBrush="{DynamicResource WarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Settings.Badge.Advanced}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningTextBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="desc"
                                   Text="{loc:Tr Settings.DeveloperMode.Desc}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="{loc:Tr Common.Enabled}"
                                      MinWidth="84"
                                      CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding DeveloperMode}"/>
                        <ToggleButton Content="{loc:Tr Common.Disabled}"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding !DeveloperMode}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,6,0,16" />

                <!-- Remote files -->
                <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings.Section.RemoteFiles}" />

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.DownloadFolder}" />
                        <TextBlock Classes="desc"
                                   Text="{loc:Tr Settings.DownloadFolder.Desc}" />
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                        <TextBox Grid.Column="0"
                                 Text="{Binding RemoteDownloadPath}"
                                 PlaceholderText="{loc:Tr Settings.Placeholder.DefaultAppData}" />
                        <Button Grid.Column="1"
                                Content="..."
                                Width="40"
                                Height="40"
                                Padding="0"
                                Classes="focused"
                                Command="{Binding BrowseDownloadPathCommand}" />
                    </Grid>
                </Grid>

                <Separator Margin="0,6,0,16" />

                <!-- Reports -->
                <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings.Section.Reports}" />

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.ReportsFolder}" />
                        <TextBlock Classes="desc"
                                   Text="{loc:Tr Settings.ReportsFolder.Desc}" />
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ReportsPath}"
                                 PlaceholderText="{loc:Tr Settings.Placeholder.DefaultAppData}" />

                        <Button Grid.Column="1"
                                Content="..."
                                Width="40"
                                Height="40"
                                Padding="0"
                                Classes="focused"
                                Command="{Binding BrowseReportsPathCommand}" />
                    </Grid>
                </Grid>

                <Separator Margin="0,6,0,16" />

                <!-- Storage -->
                <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings.Section.Storage}" />

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.Storage.Mode}" />
                        <TextBlock Classes="desc"
                                   Text="{loc:Tr Settings.Storage.Mode.Desc}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AvailableStorageModes}"
                              SelectedItem="{Binding SelectedStorageMode}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:StorageModeOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.Storage.Folder}" />
                        <TextBlock Classes="desc"
                                   Text="{loc:Tr Settings.Storage.Folder.Desc}" />
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                        <TextBox Grid.Column="0"
                                 Text="{Binding StoragePath}"
                                 PlaceholderText="{loc:Tr Settings.Placeholder.DefaultAppData}" />
                        <Button Grid.Column="1"
                                Content="..."
                                Width="40"
                                Height="40"
                                Padding="0"
                                Classes="focused"
                                Command="{Binding BrowseStoragePathCommand}" />
                    </Grid>
                </Grid>

                <Separator Margin="0,6,0,16" />

                <!-- Logs -->
                <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings.Section.Logs}" />

                <!-- Предупреждение: смена путей логов требует перезапуска -->
                <Border Background="{DynamicResource WarningSurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">
                    <TextBlock Text="{loc:Tr Settings.Logs.RestartWarning}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource WarningTextBrush}" />
                </Border>

                <!-- Application log -->
                <StackPanel Spacing="6" Margin="0,0,0,12">
                    <TextBlock Text="{loc:Tr Settings.AppLogFile}"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                                 Text="{Binding AppLogPath}"
                                 PlaceholderText="{loc:Tr Settings.Placeholder.AppLog}" />
                        <Button Grid.Column="1" Width="40" Height="40" Padding="0" Content="..." Classes="focused" Command="{Binding BrowseAppLogPathCommand}" />

                        <Button Grid.Column="2" Width="40" Height="40" Classes="normal" Command="{Binding OpenAppLogFolderCommand}">
                            <Svg Width="20" Height="20" Path="{DynamicResource FileSearchIcon}" Css="{DynamicResource ThemeIconStroke}" />
                        </Button>

                        <Button Grid.Column="3" Width="40" Height="40" Classes="danger" Command="{Binding ClearAppLogsCommand}">
                            <Svg Width="20" Height="20" Path="{DynamicResource TrashIcon}" Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Parser log -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr Settings.ParserLogFile}"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ParserLogPath}"
                                 PlaceholderText="{loc:Tr Settings.Placeholder.ParserLog}" />

                        <Button Grid.Column="1" Content="..." Width="40" Height="40" Padding="0" Classes="focused" Command="{Binding BrowseParserLogPathCommand}" />

                        <Button Grid.Column="2" Width="40" Height="40" Classes="normal" Command="{Binding OpenParserLogFolderCommand}">
                            <Svg Width="20" Height="20" Path="{DynamicResource FileSearchIcon}" Css="{DynamicResource ThemeIconStroke}" />
                        </Button>

                        <Button Grid.Column="3" Width="40" Height="40" Classes="danger" Command="{Binding ClearAppLogsCommand}">
                            <Svg Width="20" Height="20" Path="{DynamicResource TrashIcon}" Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <Separator Margin="0,6,0,16" />

                <!-- Parser rules -->
                <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings.Section.ParserRules}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="{loc:Tr Settings.ParserRules.Desc}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                        <Button Height="40"
                                Classes="focused"
                                ToolTip.Tip="{loc:Tr Settings.ParserRules.ImportTip}"
                                Command="{Binding ImportRulesFileCommand}">

                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Svg Width="20" Height="20" Path="{DynamicResource ImportIcon}" Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                                <TextBlock Text="{loc:Tr Settings.Import}" />
                            </StackPanel>
                        </Button>

                        <Button Height="40"
                                Classes="normal"
                                ToolTip.Tip="{loc:Tr Settings.ParserRules.OpenTip}"
                                Command="{Binding OpenRulesFolderCommand}">

                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Svg Width="20" Height="20" Path="{DynamicResource FileSearchIcon}" Css="{DynamicResource ThemeIconStroke}" />
                                <TextBlock Text="{loc:Tr Settings.OpenFolder}" />
                            </StackPanel>

                        </Button>
                    </StackPanel>
                </Grid>
                <Border Background="{DynamicResource WarningSurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0 15 0 0"
                        Padding="12">
                    <TextBlock Text="{loc:Tr Settings.ParserRules.RestartWarning}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource WarningTextBrush}" />
                </Border>

                <StackPanel Spacing="8">

                </StackPanel>

                <Separator Margin="0,6,0,16" />

                <!-- UI sections visibility -->
                <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings.Section.Sections}" />

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Grid.Column="0" Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.SectionVis.Files}" />
                        <TextBlock Classes="desc" Text="{loc:Tr Settings.SectionVis.Files.Desc}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="{loc:Tr Common.Show}"
                                      MinWidth="84"
                                      CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding SectionFiles}"/>
                        <ToggleButton Content="{loc:Tr Common.Hidden}"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding !SectionFiles}"/>
                    </StackPanel>
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.SectionVis.Search}" />
                        <TextBlock Classes="desc" Text="{loc:Tr Settings.SectionVis.Search.Desc}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="{loc:Tr Common.Show}"
                                      MinWidth="84"
                                      CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding SectionSearch}"/>
                        <ToggleButton Content="{loc:Tr Common.Hidden}"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding !SectionSearch}"/>
                    </StackPanel>
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.SectionVis.Events}" />
                        <TextBlock Classes="desc" Text="{loc:Tr Settings.SectionVis.Events.Desc}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="{loc:Tr Common.Show}"
                                      MinWidth="84"
                                      CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding SectionEvents}"/>
                        <ToggleButton Content="{loc:Tr Common.Hidden}"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding !SectionEvents}"/>
                    </StackPanel>
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.SectionVis.Statistics}" />
                        <TextBlock Classes="desc" Text="{loc:Tr Settings.SectionVis.Statistics.Desc}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="{loc:Tr Common.Show}"
                                      MinWidth="84"
                                      CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding SectionStatistics}"/>
                        <ToggleButton Content="{loc:Tr Common.Hidden}"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding !SectionStatistics}"/>
                    </StackPanel>
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="{loc:Tr Settings.SectionVis.Logs}" />
                        <TextBlock Classes="desc" Text="{loc:Tr Settings.SectionVis.Logs.Desc}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="{loc:Tr Common.Show}"
                                      MinWidth="84"
                                      CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding SectionLogs}"/>
                        <ToggleButton Content="{loc:Tr Common.Hidden}"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding !SectionLogs}"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">

                <TextBlock Grid.Row="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">

                    <Button Grid.Column="0"
                            Classes="normal"
                            Command="{Binding ResetToDefaultsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Svg Width="20" Height="20" Path="{DynamicResource ResetIcon}" Css="{DynamicResource ThemeIconFill}" />
                            <TextBlock Text="{loc:Tr Settings.ResetDefaults}" />
                        </StackPanel>
                    </Button>


                    <Button Grid.Column="2"
                            Height="40"
                            Classes="focused"
                            Command="{Binding SaveCommand}" >

                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Svg Path="{DynamicResource SaveIcon}"
                                 Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                            <TextBlock Text="{loc:Tr Common.Save}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Height="40"
                            Classes="danger"
                            Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Svg Path="{DynamicResource ClearIcon}"
                                 Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                            <TextBlock Text="{loc:Tr Common.Cancel}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
