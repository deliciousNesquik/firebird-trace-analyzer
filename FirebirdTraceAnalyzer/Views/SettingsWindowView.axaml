<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="640"
             x:Class="FirebirdTraceAnalyzer.Views.SettingsWindowView"
             x:DataType="vm:SettingsWindowViewModel"
             Width="640"
             MaxHeight="720">

    <Design.DataContext>
        <vm:SettingsWindowViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Строка настройки: слева название+описание, справа редактор значения.
             ColumnDefinitions задаётся инлайн на каждом Grid (через Style для коллекции
             ColumnDefinitions в Avalonia работает ненадёжно). -->
        <Style Selector="Grid.settingRow">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style Selector="Grid.settingRow > StackPanel.label">
            <Setter Property="Spacing" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style Selector="Grid.settingRow > StackPanel.label > TextBlock.title">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Grid.settingRow > StackPanel.label > TextBlock.desc">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="5">
                    <TextBlock Text="Application Settings"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Values are applied after you press Save"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                    <Button Height="40"
                            Classes="normal"
                            ToolTip.Tip="Importing settings from a file will overwrite all current settings. Use with caution."
                            Command="{Binding ImportCommand}">
                        
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Svg Width="20" Height="20" Path="{DynamicResource ImportIcon}" Css="{DynamicResource ThemeIconStroke}" />
                            <TextBlock Text="Import" />
                        </StackPanel>
                        
                    </Button>

                    <Button Height="40"
                            Classes="normal"
                            Command="{Binding ExportCommand}"
                            ToolTip.Tip="Export current settings to a file.">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Svg Height="20" Path="{DynamicResource ExportIcon}" Css="{DynamicResource ThemeIconStroke}" />
                            <TextBlock Text="Export" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20" Spacing="4">

                <!-- General -->
                <TextBlock Classes="sectionHeader" Text="General" />

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="Search mode" />
                        <TextBlock Classes="desc"
                                   Text="Classic — plain substring search. Regex — regular expressions." />
                    </StackPanel>
                    <!-- Сегмент из двух кнопок: слева Classic, справа Regex. Клик всегда выставляет
                         нужный режим (Command), IsChecked отражает состояние в одну сторону. -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="Classic"
                                      MinWidth="84"
                                        CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding IsClassicSearch, Mode=OneWay}"
                                      Command="{Binding SelectClassicCommand}" />
                        <ToggleButton Content="Regex"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding IsRegexSearch, Mode=OneWay}"
                                      Command="{Binding SelectRegexCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="Theme" />
                        <TextBlock Classes="desc"
                                   Text="Application color theme." />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding Theme}" />
                </Grid>

                <Separator Margin="0,6,0,16" />

                <!-- Remote files -->
                <TextBlock Classes="sectionHeader" Text="Remote files" />

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="Download folder" />
                        <TextBlock Classes="desc"
                                   Text="Folder where downloaded remote files are kept (when 'delete after processing' is off). Empty = default app folder." />
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                        <TextBox Grid.Column="0"
                                 Text="{Binding RemoteDownloadPath}"
                                 PlaceholderText="Default (AppData)" />
                        <Button Grid.Column="1"
                                Content="..."
                                Width="40"
                                Height="40"
                                Padding="0"
                                Classes="focused"
                                Command="{Binding BrowseDownloadPathCommand}" />
                    </Grid>
                </Grid>

                <Separator Margin="0,6,0,16" />

                <!-- Reports -->
                <TextBlock Classes="sectionHeader" Text="Reports" />

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="Reports folder" />
                        <TextBlock Classes="desc"
                                   Text="Folder where generated reports are saved. Empty = default app folder." />
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ReportsPath}"
                                 PlaceholderText="Default (AppData)" />
                        
                        <Button Grid.Column="1"
                                Content="..."
                                Width="40"
                                Height="40"
                                Padding="0"
                                Classes="focused"
                                Command="{Binding BrowseReportsPathCommand}" />
                    </Grid>
                </Grid>

                <Separator Margin="0,6,0,16" />

                <!-- Logs -->
                <TextBlock Classes="sectionHeader" Text="Logs" />

                <!-- Предупреждение: смена путей логов требует перезапуска -->
                <Border Background="{DynamicResource WarningSurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">
                    <TextBlock Text="Changing log file paths takes full effect only after restarting the application (the parser log is initialized at startup)."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource WarningTextBrush}" />
                </Border>

                <!-- Application log -->
                <StackPanel Spacing="6" Margin="0,0,0,12">
                    <TextBlock Text="Application log file"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                                 Text="{Binding AppLogPath}"
                                 PlaceholderText="Default (logs/application.log)" />
                        <Button Grid.Column="1" Width="40" Height="40" Padding="0" Content="..." Classes="focused" Command="{Binding BrowseAppLogPathCommand}" />
                        
                        <Button Grid.Column="2" Width="40" Height="40" Classes="normal" Command="{Binding OpenAppLogFolderCommand}">
                            <Svg Width="20" Height="20" Path="{DynamicResource FileSearchIcon}" Css="{DynamicResource ThemeIconStroke}" />
                        </Button>
                        
                        <Button Grid.Column="3" Width="40" Height="40" Classes="danger" Command="{Binding ClearAppLogsCommand}">
                            <Svg Width="20" Height="20" Path="{DynamicResource TrashIcon}" Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Parser log -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Parser log file"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ParserLogPath}"
                                 PlaceholderText="Default (logs/parser.log)" />
                        
                        <Button Grid.Column="1" Content="..." Width="40" Height="40" Padding="0" Classes="focused" Command="{Binding BrowseParserLogPathCommand}" />
                        
                        <Button Grid.Column="2" Width="40" Height="40" Classes="normal" Command="{Binding OpenParserLogFolderCommand}">
                            <Svg Width="20" Height="20" Path="{DynamicResource FileSearchIcon}" Css="{DynamicResource ThemeIconStroke}" />
                        </Button>
                        
                        <Button Grid.Column="3" Width="40" Height="40" Classes="danger" Command="{Binding ClearAppLogsCommand}">
                            <Svg Width="20" Height="20" Path="{DynamicResource TrashIcon}" Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <Separator Margin="0,6,0,16" />

                <!-- Parser rules -->
                <TextBlock Classes="sectionHeader" Text="Parser rules" />
                
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="rules.json defines how trace lines are parsed. It lives in the app data folder — import a custom file or open the folder to edit it."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                        <Button Height="40"
                                Classes="focused"
                                ToolTip.Tip="Import rules.json"
                                Command="{Binding ImportRulesFileCommand}">
                            
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Svg Width="20" Height="20" Path="{DynamicResource ImportIcon}" Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>

                        <Button Height="40"
                                Classes="normal"
                                ToolTip.Tip="Open rules folder"
                                Command="{Binding OpenRulesFolderCommand}">
                            
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Svg Width="20" Height="20" Path="{DynamicResource FileSearchIcon}" Css="{DynamicResource ThemeIconFill}" />
                                <TextBlock Text="Open Folder" />
                            </StackPanel>
                            
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Background="{DynamicResource WarningSurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0 15 0 0"
                        Padding="12">
                    <TextBlock Text="Importing rules takes effect after restarting the application."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource WarningTextBrush}" />
                </Border>
                
                <StackPanel Spacing="8">
                    
                </StackPanel>

                <Separator Margin="0,6,0,16" />

                <!-- UI sections visibility -->
                <TextBlock Classes="sectionHeader" Text="Sections visibility" />

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Grid.Column="0" Classes="label">
                        <TextBlock Classes="title" Text="Files" />
                        <TextBlock Classes="desc" Text="Show the loaded trace files section." />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="Show"
                                      MinWidth="84"
                                      CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding SectionFiles}"/>
                        <ToggleButton Content="Hidden"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding !SectionFiles}"/>
                    </StackPanel>
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="Search, Sort and Filters" />
                        <TextBlock Classes="desc" Text="Show the search / sort / filters section." />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="Show"
                                      MinWidth="84"
                                      CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding SectionSearch}"/>
                        <ToggleButton Content="Hidden"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding !SectionSearch}"/>
                    </StackPanel>
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="Events" />
                        <TextBlock Classes="desc" Text="Show the events list section." />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="Show"
                                      MinWidth="84"
                                      CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding SectionEvents}"/>
                        <ToggleButton Content="Hidden"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding !SectionEvents}"/>
                    </StackPanel>
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="Statistics" />
                        <TextBlock Classes="desc" Text="Show the statistics section." />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="Show"
                                      MinWidth="84"
                                      CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding SectionStatistics}"/>
                        <ToggleButton Content="Hidden"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding !SectionStatistics}"/>
                    </StackPanel>
                </Grid>

                <Grid Classes="settingRow" ColumnDefinitions="*,280">
                    <StackPanel Classes="label">
                        <TextBlock Classes="title" Text="Logs" />
                        <TextBlock Classes="desc" Text="Show the logs section." />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ToggleButton Content="Show"
                                      MinWidth="84"
                                      CornerRadius="4,0,0,4"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding SectionLogs}"/>
                        <ToggleButton Content="Hidden"
                                      MinWidth="84"
                                      CornerRadius="0,4,4,0"
                                      HorizontalContentAlignment="Center"
                                      IsChecked="{Binding !SectionLogs}"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">

                <TextBlock Grid.Row="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    
                    <Button Grid.Column="0"
                            Classes="normal"
                            Command="{Binding ResetToDefaultsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Svg Width="20" Height="20" Path="{DynamicResource ResetIcon}" Css="{DynamicResource ThemeIconFill}" />
                            <TextBlock Text="Reset to defaults" />
                        </StackPanel>
                    </Button>
                    

                    <Button Grid.Column="2"
                            Height="40"
                            Classes="focused"
                            Command="{Binding SaveCommand}" >
                        
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Svg Path="{DynamicResource SaveIcon}"
                                 Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Height="40"
                            Classes="danger"
                            Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Svg Path="{DynamicResource ClearIcon}"
                                 Css="{DynamicResource ThemeIconStrokeOnlyWhite}" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
