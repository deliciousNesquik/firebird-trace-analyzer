<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="FirebirdTraceAnalyzer.Views.EventInspectorWindow"
        x:DataType="vm:EventInspectorViewModel"
        Title="{Binding Title}"
        Width="900"
        Height="700"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Кнопка «⋯» карточки не нужна внутри инспектора — навигация уже здесь. -->
        <Style Selector="Button.card-action">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Event Inspector"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            ToolTip.Tip="This feature is experimental: only same-statement lifecycles pair reliably; procedure/trigger pairing is best-effort and cross-event causality (which statement fired a trigger) is not tracked.">
                        <TextBlock Text="EXPERIMENTAL"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding ChainSummary}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Margin="20">

                <!-- Selected event -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Selected event"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource AccentBrush}" />

                    <ContentControl Content="{Binding FocusedEvent}" />
                </StackPanel>

                <Separator />

                <!-- Lifecycle chain -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Lifecycle chain"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBlock Text="The operation's own lifecycle (e.g. the same statement) with connection and trace-session bookends. Selected event is highlighted."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <ItemsRepeater ItemsSource="{Binding Chain}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChainItemViewModel">
                                <Grid ColumnDefinitions="4,*" Margin="0,0,0,8">
                                    <!-- Accent bar for the focused event -->
                                    <Border Grid.Column="0"
                                            Width="4"
                                            CornerRadius="2"
                                            Background="{DynamicResource AccentBrush}"
                                            IsVisible="{Binding IsFocused}" />

                                    <ContentControl Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    Content="{Binding Event}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <Button Content="Close"
                    Classes="danger"
                    HorizontalAlignment="Right"
                    Click="CloseButton_OnClick" />
        </Border>

    </Grid>
</Window>
