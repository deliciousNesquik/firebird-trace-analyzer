<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        СВЕТЛАЯ ТЕМА.

        Палитра приложения. Все токены — это SolidColorBrush; UI ссылается на них
        через {DynamicResource KEY}. Чтобы сделать свою тему, скопируйте этот файл
        и поменяйте только hex-значения: набор ключей и их смысл должны совпадать с
        Dark.axaml один-в-один (симметрия гарантирует, что любая тема полна).

        Разделы:
          1. Поверхности      — фоны окна и панелей
          2. Текст            — уровни текста + текст на акценте
          3. Границы          — обводки и тонкие разделители
          4. Акцент           — основной цвет действия/выделения
          5. Статусы          — успех / опасность
          6. Баннеры          — фон/граница/текст для ошибок и предупреждений
          7. Палитра событий  — по одному цвету на тип события трассировки
          8. Кнопки           — normal / focused / danger × состояния
          9. Иконки (CSS)     — перекраска SVG под тему
    -->

    <!-- 1. Поверхности -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#E3E3E3" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />

    <!-- 2. Текст -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#141414" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- 3. Границы -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E5E7EB" />

    <!-- Таблица отчёта: подложка заголовка и «зебра» строк на «бумажной» странице превью -->
    <SolidColorBrush x:Key="ReportHeaderRowBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ReportAltRowBrush" Color="#FAFAFB" />

    <!-- 4. Акцент -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />

    <!-- 5. Статусы -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E8B57" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C24545" />

    <!-- 6. Баннеры (ошибки / предупреждения) -->
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#F5C2C2" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#B83232" />

    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FEF7E6" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#F5E0A6" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#8A6D1B" />

    <!-- 7. Палитра событий трассировки (фон бейджа в карточке события) -->
    <SolidColorBrush x:Key="TraceInitEventBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="TraceFiniEventBrush" Color="#C62828" />

    <SolidColorBrush x:Key="AttachDatabaseEventBrush" Color="#1565C0" />
    <SolidColorBrush x:Key="DetachDatabaseEventBrush" Color="#546E7A" />

    <SolidColorBrush x:Key="StatementStartEventBrush" Color="#E65100" />
    <SolidColorBrush x:Key="StatementRestartEventBrush" Color="#E65100" />
    <SolidColorBrush x:Key="StatementFinishEventBrush" Color="#FB8C00" />
    <SolidColorBrush x:Key="FailedStatementFinishEventBrush" Color="#D50000" />

    <SolidColorBrush x:Key="ProcedureStartEventBrush" Color="#1B5E20" />
    <SolidColorBrush x:Key="ProcedureFinishEventBrush" Color="#43A047" />
    <SolidColorBrush x:Key="FailedProcedureFinishEventBrush" Color="#BF360C" />

    <SolidColorBrush x:Key="TriggerStartEventBrush" Color="#6A1B9A" />
    <SolidColorBrush x:Key="TriggerFinishEventBrush" Color="#8E24AA" />
    <SolidColorBrush x:Key="FailedTriggerFinishEventBrush" Color="#AD1457" />

    <SolidColorBrush x:Key="ErrorEventBrush" Color="#B71C1C" />

    <!-- 8. Кнопки: Normal -->
    <SolidColorBrush x:Key="ButtonNormalBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonNormalBorderBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="ButtonNormalForegroundBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="ButtonNormalHoverBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ButtonNormalHoverBorderBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="ButtonNormalHoverForegroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="ButtonNormalPressedBackgroundBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ButtonNormalPressedBorderBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="ButtonNormalDisabledBackgroundBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="ButtonNormalDisabledBorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ButtonNormalDisabledForegroundBrush" Color="#9CA3AF" />

    <!-- 8. Кнопки: Focused -->
    <SolidColorBrush x:Key="ButtonFocusedBackgroundBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ButtonFocusedBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ButtonFocusedForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonFocusedHoverBackgroundBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="ButtonFocusedHoverBorderBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="ButtonFocusedHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonFocusedPressedBackgroundBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="ButtonFocusedPressedBorderBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="ButtonFocusedDisabledBackgroundBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="ButtonFocusedDisabledBorderBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="ButtonFocusedDisabledForegroundBrush" Color="#EFF6FF" />

    <!-- 8. Кнопки: Danger -->
    <SolidColorBrush x:Key="ButtonDangerBackgroundBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="ButtonDangerBorderBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="ButtonDangerForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonDangerHoverBackgroundBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="ButtonDangerHoverBorderBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="ButtonDangerHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonDangerPressedBackgroundBrush" Color="#991B1B" />
    <SolidColorBrush x:Key="ButtonDangerPressedBorderBrush" Color="#991B1B" />
    <SolidColorBrush x:Key="ButtonDangerDisabledBackgroundBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="ButtonDangerDisabledBorderBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="ButtonDangerDisabledForegroundBrush" Color="#FEF2F2" />

    <!-- 9. Иконки (CSS для перекраски SVG) -->
    <x:String x:Key="ThemeIconFill">.ThemeIconFill { fill:#141414; }</x:String>
    <x:String x:Key="ThemeIconFillAndStroke">.ThemeIconFill { fill:#141414; } .ThemeIconStroke { stroke:#141414; }</x:String>
    <x:String x:Key="ThemeIconFillOnlyWhite">.ThemeIconFill { fill:#FFFFFF; }</x:String>
    <x:String x:Key="ThemeIconFillAndStrokeOnlyWhite">.ThemeIconFill { fill:#FFFFFF; } .ThemeIconStroke { stroke:#FFFFFF; }</x:String>
    <x:String x:Key="ThemeIconStroke">.ThemeIconStroke { stroke:#141414; }</x:String>
    <x:String x:Key="ThemeIconStrokeOnlyWhite">.ThemeIconStroke { stroke:#FFFFFF; }</x:String>

</ResourceDictionary>
