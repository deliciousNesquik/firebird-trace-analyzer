<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ТЁМНАЯ ТЕМА.

        Палитра приложения. Все токены — это SolidColorBrush; UI ссылается на них
        через {DynamicResource KEY}. Чтобы сделать свою тему, скопируйте этот файл
        и поменяйте только hex-значения: набор ключей и их смысл должны совпадать с
        Light.axaml один-в-один (симметрия гарантирует, что любая тема полна).

        Разделы:
          1. Поверхности      — фоны окна и панелей
          2. Текст            — уровни текста + текст на акценте
          3. Границы          — обводки и тонкие разделители
          4. Акцент           — основной цвет действия/выделения
          5. Статусы          — успех / опасность
          6. Баннеры          — фон/граница/текст для ошибок и предупреждений
          7. Палитра событий  — по одному цвету на тип события трассировки
          8. Кнопки           — normal / focused / danger × состояния
          9. Иконки (CSS)     — перекраска SVG под тему
    -->

    <!-- 1. Поверхности -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#242424" />

    <!-- 2. Текст -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F1F1" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- 3. Границы -->
    <SolidColorBrush x:Key="BorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#333333" />

    <!-- Таблица отчёта: подложка заголовка и «зебра» строк на «бумажной» странице превью -->
    <SolidColorBrush x:Key="ReportHeaderRowBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ReportAltRowBrush" Color="#2A2A2A" />

    <!-- 4. Акцент -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8DEF" />

    <!-- 5. Статусы -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#47B881" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />

    <!-- 6. Баннеры (ошибки / предупреждения) -->
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#3A1E1E" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#7F3B3B" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF8585" />

    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#3A331E" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#7F6E3B" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#E0C06A" />

    <!-- 7. Палитра событий трассировки (фон бейджа в карточке события) -->
    <SolidColorBrush x:Key="TraceInitEventBrush" Color="#81C784" />
    <SolidColorBrush x:Key="TraceFiniEventBrush" Color="#E57373" />

    <SolidColorBrush x:Key="AttachDatabaseEventBrush" Color="#64B5F6" />
    <SolidColorBrush x:Key="DetachDatabaseEventBrush" Color="#90A4AE" />

    <SolidColorBrush x:Key="StatementStartEventBrush" Color="#FFB74D" />
    <SolidColorBrush x:Key="StatementRestartEventBrush" Color="#FFB74D" />
    <SolidColorBrush x:Key="StatementFinishEventBrush" Color="#FFE0B2" />
    <SolidColorBrush x:Key="FailedStatementFinishEventBrush" Color="#FF5252" />

    <SolidColorBrush x:Key="ProcedureStartEventBrush" Color="#66BB6A" />
    <SolidColorBrush x:Key="ProcedureFinishEventBrush" Color="#A5D6A7" />
    <SolidColorBrush x:Key="FailedProcedureFinishEventBrush" Color="#FF8A65" />

    <SolidColorBrush x:Key="TriggerStartEventBrush" Color="#BA68C8" />
    <SolidColorBrush x:Key="TriggerFinishEventBrush" Color="#E1BEE7" />
    <SolidColorBrush x:Key="FailedTriggerFinishEventBrush" Color="#FF4081" />

    <SolidColorBrush x:Key="ErrorEventBrush" Color="#FF1744" />

    <!-- 8. Кнопки: Normal -->
    <SolidColorBrush x:Key="ButtonNormalBackgroundBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ButtonNormalBorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="ButtonNormalForegroundBrush" Color="#F1F1F1" />
    <SolidColorBrush x:Key="ButtonNormalHoverBackgroundBrush" Color="#3B3B3B" />
    <SolidColorBrush x:Key="ButtonNormalHoverBorderBrush" Color="#555555" />
    <SolidColorBrush x:Key="ButtonNormalHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonNormalPressedBackgroundBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ButtonNormalPressedBorderBrush" Color="#666666" />
    <SolidColorBrush x:Key="ButtonNormalDisabledBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ButtonNormalDisabledBorderBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ButtonNormalDisabledForegroundBrush" Color="#666666" />

    <!-- 8. Кнопки: Focused -->
    <SolidColorBrush x:Key="ButtonFocusedBackgroundBrush" Color="#5B8DEF" />
    <SolidColorBrush x:Key="ButtonFocusedBorderBrush" Color="#5B8DEF" />
    <SolidColorBrush x:Key="ButtonFocusedForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonFocusedHoverBackgroundBrush" Color="#4A7FE0" />
    <SolidColorBrush x:Key="ButtonFocusedHoverBorderBrush" Color="#4A7FE0" />
    <SolidColorBrush x:Key="ButtonFocusedHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonFocusedPressedBackgroundBrush" Color="#3D6FCC" />
    <SolidColorBrush x:Key="ButtonFocusedPressedBorderBrush" Color="#3D6FCC" />
    <SolidColorBrush x:Key="ButtonFocusedDisabledBackgroundBrush" Color="#7AA3F2" />
    <SolidColorBrush x:Key="ButtonFocusedDisabledBorderBrush" Color="#7AA3F2" />
    <SolidColorBrush x:Key="ButtonFocusedDisabledForegroundBrush" Color="#D6E4FA" />

    <!-- 8. Кнопки: Danger -->
    <SolidColorBrush x:Key="ButtonDangerBackgroundBrush" Color="#D64545" />
    <SolidColorBrush x:Key="ButtonDangerBorderBrush" Color="#D64545" />
    <SolidColorBrush x:Key="ButtonDangerForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonDangerHoverBackgroundBrush" Color="#C33B3B" />
    <SolidColorBrush x:Key="ButtonDangerHoverBorderBrush" Color="#C33B3B" />
    <SolidColorBrush x:Key="ButtonDangerHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonDangerPressedBackgroundBrush" Color="#B03232" />
    <SolidColorBrush x:Key="ButtonDangerPressedBorderBrush" Color="#B03232" />
    <SolidColorBrush x:Key="ButtonDangerDisabledBackgroundBrush" Color="#E58989" />
    <SolidColorBrush x:Key="ButtonDangerDisabledBorderBrush" Color="#E58989" />
    <SolidColorBrush x:Key="ButtonDangerDisabledForegroundBrush" Color="#FBE8E8" />

    <!-- 9. Иконки (CSS для перекраски SVG) -->
    <x:String x:Key="ThemeIconFill">.ThemeIconFill { fill:#F1F1F1; }</x:String>
    <x:String x:Key="ThemeIconFillAndStroke">.ThemeIconFill { fill:#F1F1F1; } .ThemeIconStroke { stroke:#F1F1F1; }</x:String>
    <x:String x:Key="ThemeIconFillOnlyWhite">.ThemeIconFill { fill:#FFFFFF; }</x:String>
    <x:String x:Key="ThemeIconFillAndStrokeOnlyWhite">.ThemeIconFill { fill:#FFFFFF; } .ThemeIconStroke { stroke:#FFFFFF; }</x:String>
    <x:String x:Key="ThemeIconStroke">.ThemeIconStroke { stroke:#F1F1F1; }</x:String>
    <x:String x:Key="ThemeIconStrokeOnlyWhite">.ThemeIconStroke { stroke:#FFFFFF; }</x:String>

</ResourceDictionary>
