<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogLevel="Warn"><!-- Путь внутреннего лога NLog задаётся из C# (LogConfiguration): его упрощённый
           парсер не понимает ${specialfolder:folder=...} и создаёт папку с буквальным именем. -->

    <!-- ИНВАРИАНТЫ КОНФИГА (не менять без чтения LogConfiguration.cs):
         1. keepFileOpen НЕ задан (по умолчанию false): пути из GDC подхватываются на каждой
            записи, а кнопка «очистить логи» может удалять файлы. С keepFileOpen=true смена
            пути перестанет применяться, а ClearLogs начнёт молча не удаваться на Windows.
         2. autoReload убран сознательно: в упакованном приложении config не редактируется,
            а перезагрузка на лету теряет хвост async-очереди. Правки конфига = перезапуск.
         3. minlevel=Debug в файловых таргетах — сознательный выбор: логи служат каналом
            багрепортов, объём Debug копеечный (только старт). Если появится болтливый
            Debug-сайт — понижать его уровень до Trace, а не порог здесь. -->

    <extensions>
        <add assembly="NLog.Extensions.Logging"/>
    </extensions>

    <targets async="true">
        <!-- Лог приложения. Путь задаётся через GDC (LogConfiguration); по умолчанию — в %AppData%/FirebirdTraceAnalyzer/logs -->
        <target xsi:type="File"
                name="logfile"
                fileName="${gdc:item=appLogFile:whenEmpty=logs/application.log}"
                layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}"
                archiveEvery="Day"
                maxArchiveFiles="30" />

        <!-- Отдельный лог парсера (логгеры FirebirdTraceParser*) -->
        <target xsi:type="File"
                name="parserfile"
                fileName="${gdc:item=parserLogFile:whenEmpty=logs/parser.log}"
                layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}"
                archiveEvery="Day"
                maxArchiveFiles="30" />

        <target xsi:type="ColoredConsole"
                name="console"
                useDefaultRowHighlightingRules="true"
                layout="${time}|${level:uppercase=true}|${message}${onexception:inner=${newline}${exception:format=message}}">
            <highlight-row condition="level == LogLevel.Debug" foregroundColor="DarkGray" />
            <highlight-row condition="level == LogLevel.Info" foregroundColor="White" />
            <highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow" />
            <highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
            <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White" />
        </target>
    </targets>

    <rules>
        <!-- Логи парсера идут в отдельный файл и НЕ дублируются в лог приложения (final="true").
             Два правила: точное имя инъектируемого логгера "FirebirdTraceParser" И его потомки
             "FirebirdTraceParser.*" (классовые логгеры). Одного "FirebirdTraceParser*" недостаточно:
             точное имя без хвоста им не ловилось, и эти строки утекали в лог приложения. -->
        <logger name="FirebirdTraceParser" minlevel="Debug" writeTo="parserfile,console" final="true" />
        <logger name="FirebirdTraceParser.*" minlevel="Debug" writeTo="parserfile,console" final="true" />

        <!-- Всё остальное — в лог приложения -->
        <logger name="*" minlevel="Debug" writeTo="logfile,console" />
    </rules>
</nlog>
