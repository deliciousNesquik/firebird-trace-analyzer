<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
        xmlns:events="using:FirebirdTraceAnalyzer.Controls.EventCards"
        xmlns:models="clr-namespace:FirebirdTraceParser.Models.ValueObjects;assembly=FirebirdTraceParser"
        xmlns:controls="clr-namespace:FirebirdTraceAnalyzer.Controls">

    <Design.PreviewWith>

        <Border Padding="20">

            <events:ErrorEventCard
                Width="900"
                Timestamp="2026 05 18 11:30:00"
                TraceId="437236"
                HexTraceId="0x7f3133ba1dc0"
                AttachmentId="11335646"
                Component="JResultSet::fetchNext" />

        </Border>

    </Design.PreviewWith>

    <Style Selector="events|ErrorEventCard">

        <Setter Property="Template">

            <ControlTemplate>

                <Border BorderThickness="1"
                        Padding="10"
                        BorderBrush="{DynamicResource BorderBrush}">

                    <StackPanel Spacing="10">

                        <!-- HEADER -->

                        <Grid ColumnDefinitions="Auto,*">

                            <Border Grid.Column="0"
                                    Background="{DynamicResource ErrorEventBrush}"
                                    CornerRadius="5"
                                    Padding="16,8,16,12">

                                <TextBlock Text="{loc:Tr EventCard.Type.Error}"
                                           Foreground="{DynamicResource TextOnAccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="16"/>

                            </Border>

                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="{Binding Timestamp,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              StringFormat='{}{0:yyyy-MM-ddTHH:mm:ss.ffff}'}"
                                       FontFamily="Consolas"
                                       FontSize="16"
                                       FontWeight="DemiBold"/>


                        </Grid>

                        <!-- IDS -->

                        <Border>

                            <Grid ColumnDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="30">

                                <StackPanel Grid.Column="0"
                                            Spacing="4">

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="5">

                                        <TextBlock Text="{loc:Tr EventCard.TraceId}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    </StackPanel>

                                    <TextBlock Text="{TemplateBinding TraceId}"
                                               FontWeight="Bold"
                                               FontFamily="Consolas"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Spacing="4">

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="5">

                                        <TextBlock Text="{loc:Tr EventCard.Hex}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    </StackPanel>

                                    <TextBlock Text="{TemplateBinding HexTraceId}"
                                               FontFamily="Consolas"/>

                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Spacing="4">

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="5">

                                        <TextBlock Text="{loc:Tr EventCard.AttachmentId}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    </StackPanel>

                                    <TextBlock Text="{TemplateBinding AttachmentId}"
                                               FontFamily="Consolas"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- COMPONENT -->

                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="10">

                            <Grid ColumnDefinitions="*,Auto">

                                <TextBlock Grid.Column="0"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           Text="{Binding Component,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  StringFormat='{}Error at: {0}'}"
                                           TextWrapping="Wrap"/>

                                <controls:CopyButton Grid.Column="1" Classes="parameters" 
                                                     VerticalAlignment="Top"
                                                     Height="30" Width="30"
                                                     Text="{Binding Component,
                                                        RelativeSource={RelativeSource TemplatedParent},
                                                        StringFormat='{}Error at: {0}'}" />

                            </Grid>

                        </Border>

                        <!-- ERRORS -->

                        <ItemsControl ItemsSource="{Binding Errors,
                                                    RelativeSource={RelativeSource TemplatedParent}}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate x:DataType="models:ErrorLines">

                                    <Border BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource SurfaceElevatedBrush}"
                                            Padding="0,4">

                                        <Grid ColumnDefinitions="140,*">

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ErrorCode}"
                                                       FontFamily="Consolas"
                                                       FontWeight="Bold"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Message}"
                                                       TextWrapping="Wrap"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <!-- FOOTER: open event inspector -->
                        <Border>
                            <Button Classes="focused open-inspector"
                                    HorizontalAlignment="Right"
                                    Height="30"
                                    Padding="12,0"
                                    ToolTip.Tip="{loc:Tr EventCard.OpenInspectorTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Svg Width="18" Height="18" Path="{DynamicResource HistoryIcon}" Css="{DynamicResource ThemeIconFillAndStrokeOnlyWhite}" />
                                    <TextBlock Text="{loc:Tr EventCard.Inspect}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>

                </Border>

            </ControlTemplate>

        </Setter>

    </Style>

</Styles>