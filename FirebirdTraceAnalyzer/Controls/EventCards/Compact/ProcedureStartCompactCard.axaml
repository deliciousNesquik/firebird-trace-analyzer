<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
        xmlns:events="using:FirebirdTraceAnalyzer.Controls.EventCards.Compact">
    <Design.PreviewWith>
        <Border Padding="10" Width="700">
            <events:ProcedureStartCompactCard Timestamp="2026-05-18 11:30:01" AttachmentId="9002153"
                                              ProcedureName="SP_RECALC_BALANCE" />
        </Border>
    </Design.PreviewWith>

    <Style Selector="events|ProcedureStartCompactCard">
        <Setter Property="Template">
            <ControlTemplate>
                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Border BorderBrush="{DynamicResource ProcedureStartEventBrush}" BorderThickness="3,0,0,0" Padding="12,7">
                        <Grid ColumnDefinitions="112,88,*,Auto,Auto,Auto" ColumnSpacing="14">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{loc:Tr EventCard.Compact.Procedure}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding AttachmentId, RelativeSource={RelativeSource TemplatedParent}, StringFormat='#{0}'}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Text="{TemplateBinding ProcedureName}"
                                       FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                       Text="{Binding Timestamp, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <Button Grid.Column="5" VerticalAlignment="Center"
                                    Classes="open-inspector"
                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                    ToolTip.Tip="{loc:Tr EventCard.OpenInspectorTooltip}">
                                <Svg Width="15" Height="15" Path="{DynamicResource HistoryIcon}"
                                     Css="{DynamicResource ThemeIconFillAndStroke}" />
                            </Button>
                        </Grid>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
