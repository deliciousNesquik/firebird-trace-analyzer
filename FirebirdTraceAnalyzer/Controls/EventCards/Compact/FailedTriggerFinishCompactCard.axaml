<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
        xmlns:converters="using:FirebirdTraceAnalyzer.Converters"
        xmlns:events="using:FirebirdTraceAnalyzer.Controls.EventCards.Compact">
    <Design.PreviewWith>
        <Border Padding="10" Width="760">
            <events:FailedTriggerFinishCompactCard Timestamp="2026-05-18 11:30:01" AttachmentId="9002153" ExecuteMs="4"
                                                   TriggerName="TRG_ACCOUNTS_GUARD" Table="ACCOUNTS" Timing="BEFORE" Event="UPDATE" />
        </Border>
    </Design.PreviewWith>

    <Style Selector="events|FailedTriggerFinishCompactCard">
        <Setter Property="Template">
            <ControlTemplate>
                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Border BorderBrush="{DynamicResource FailedTriggerFinishEventBrush}" BorderThickness="3,0,0,0" Padding="12,7">
                        <Grid ColumnDefinitions="112,88,*,Auto,Auto,Auto" ColumnSpacing="14">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{loc:Tr EventCard.Compact.Trigger}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding AttachmentId, RelativeSource={RelativeSource TemplatedParent}, StringFormat='#{0}'}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontFamily="Consolas" FontSize="12">
                                <Run Text="{Binding TriggerName, RelativeSource={RelativeSource TemplatedParent}}"
                                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Run Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run.Text>
                                        <MultiBinding Converter="{x:Static converters:TriggerSignatureConverter.Instance}">
                                            <Binding Path="Table" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Timing" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Event" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr EventCard.Compact.Failed}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FailedTriggerFinishEventBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                                            IsVisible="{Binding ExecuteMs, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:CountToVisibilityConverter.Instance}}">
                                    <TextBlock Text="{Binding ExecuteMs, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="ms" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                       Text="{Binding Timestamp, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <Button Grid.Column="5" VerticalAlignment="Center"
                                    Classes="open-inspector"
                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                    ToolTip.Tip="{loc:Tr EventCard.OpenInspectorTooltip}">
                                <Svg Width="15" Height="15" Path="{DynamicResource HistoryIcon}"
                                     Css="{DynamicResource ThemeIconFillAndStroke}" />
                            </Button>
                        </Grid>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
