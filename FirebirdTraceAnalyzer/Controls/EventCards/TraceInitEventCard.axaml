<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
        xmlns:events="using:FirebirdTraceAnalyzer.Controls.EventCards">
    <Design.PreviewWith>
        <Border Padding="20">
            <events:TraceInitEventCard Width="500" Timestamp="2026 05 18 11:30:00" TraceId="437236"
                                       HexTraceId="0x7f3133ba1dc0" SessionId="994" />
        </Border>

    </Design.PreviewWith>

    <Style Selector="events|TraceInitEventCard">

        <Setter Property="Template">

            <ControlTemplate>

                <Border BorderThickness="1" Padding="10" BorderBrush="{DynamicResource BorderBrush}">

                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto Auto * Auto">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource TraceInitEventBrush}"
                                    CornerRadius="5"
                                    Padding="16, 8, 16, 12">

                                <TextBlock Text="{loc:Tr EventCard.Type.TraceInit}"
                                           Foreground="{DynamicResource TextOnAccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="16" />
                            </Border>
                            
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="{Binding Timestamp, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:yyyy-MM-ddTHH:mm:ss.ffff}'}"
                                       FontFamily="Consolas"
                                       FontSize="16"
                                       FontWeight="DemiBold"/>


                        </Grid>

                        <Border>
                            <Grid ColumnDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="30">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr EventCard.TraceId}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{TemplateBinding TraceId}"
                                               FontWeight="Bold"
                                               Cursor="Hand"
                                               FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Spacing="4">
                                    <TextBlock Text="{loc:Tr EventCard.Hex}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{TemplateBinding HexTraceId}"
                                               Cursor="Hand"
                                               FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Spacing="4">
                                    <TextBlock Text="{loc:Tr EventCard.SessionId}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{TemplateBinding SessionId}"
                                               Cursor="Hand"
                                               FontFamily="Consolas" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- FOOTER: open event inspector -->
                        <Border>
                            <Button Classes="focused open-inspector"
                                    HorizontalAlignment="Right"
                                    Height="30"
                                    Padding="12,0"
                                    ToolTip.Tip="{loc:Tr EventCard.OpenInspectorTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Svg Width="18" Height="18" Path="{DynamicResource HistoryIcon}" Css="{DynamicResource ThemeIconFillAndStrokeOnlyWhite}" />
                                    <TextBlock Text="{loc:Tr EventCard.Inspect}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>