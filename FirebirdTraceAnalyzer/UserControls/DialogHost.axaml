<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="using:FirebirdTraceAnalyzer.Interfaces.Dialogs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="FirebirdTraceAnalyzer.UserControls.DialogHost"
             x:DataType="dialogs:IDialogService"
             IsVisible="False">

    <!-- Видимость и анимация показа/закрытия управляются в code-behind (см. DialogHost.axaml.cs):
         скрим плавно затемняется, карточка «съезжает сверху» с fade. Работает для ЛЮБОГО диалога,
         т.к. анимируется сам контейнер, а не конкретный диалог. -->
    <Panel>
        <!-- Затемнение: перехватывает ввод; клик по фону = отмена. -->
        <Border x:Name="PART_Scrim"
                Background="#99000000"
                Opacity="0"
                PointerPressed="OnBackdropPressed">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!-- Карточка диалога по центру. Стартовое состояние — скрытое (прозрачная, чуть выше центра). -->
        <Border x:Name="PART_Card"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                CornerRadius="8"
                ClipToBounds="True"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Opacity="0"
                RenderTransform="translateY(-24px)">
            <!-- Opacity/RenderTransform карточки анимирует переигрываемая Animation в code-behind
                 (enter/exit), чтобы вложенные диалоги в стеке тоже получали анимацию появления. -->
            <ContentControl x:Name="PART_Content" />
        </Border>
    </Panel>

</UserControl>
