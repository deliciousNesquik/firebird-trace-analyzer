<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:core="using:FirebirdTraceParser.Models.Events"
             xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="450"
             x:Class="FirebirdTraceAnalyzer.UserControls.EventsSection"
             x:DataType="vm:MainWindowViewModel">

    <!-- Секция отображения событий трассировки. Карточки событий рендерятся через
         неявные DataTemplate из App.axaml (по типу события). DataContext наследуется
         от хост-окна (MainWindowViewModel). -->
    <Grid IsVisible="{Binding IsEventsSectionVisible}">
        <ScrollViewer Background="{DynamicResource SurfaceElevatedBrush}">
            <Panel>
                <!-- Полный режим: детальные карточки (неявные DataTemplate по типу события из App.axaml) -->
                <ItemsRepeater ItemsSource="{Binding VisibleEvents}"
                               Margin="10"
                               IsVisible="{Binding IsFullCardMode}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Плотный режим (v0-заглушка: одна строка на событие; финальные компактные карточки — следующим шагом) -->
                <ItemsRepeater ItemsSource="{Binding VisibleEvents}"
                               Margin="10"
                               IsVisible="{Binding IsCompactCardMode}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="core:EventBase">
                            <Border Padding="10,6"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                               FontFamily="Consolas, monospace"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding EventType}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Panel>
        </ScrollViewer>

        <Border
            Padding="40"
            IsVisible="{Binding !VisibleEvents.Count}">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                MaxWidth="400">

                <TextBlock
                    Text="{loc:Tr Events.NoData}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock
                    Text="{loc:Tr Events.NoDataHint}"
                    FontSize="12"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
