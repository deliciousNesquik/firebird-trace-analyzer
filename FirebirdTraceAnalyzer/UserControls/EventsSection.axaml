<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FirebirdTraceAnalyzer.ViewModels"
             xmlns:local="using:FirebirdTraceAnalyzer.UserControls"
             xmlns:loc="clr-namespace:FirebirdTraceAnalyzer.Localization"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="450"
             x:Class="FirebirdTraceAnalyzer.UserControls.EventsSection"
             x:DataType="vm:MainWindowViewModel">

    <!-- Секция отображения событий трассировки. Карточки событий рендерятся через
         неявные DataTemplate из App.axaml (по типу события). DataContext наследуется
         от хост-окна (MainWindowViewModel). -->
    <Grid IsVisible="{Binding IsEventsSectionVisible}">
        <ScrollViewer Background="{DynamicResource SurfaceElevatedBrush}">
            <Panel>
                <!-- Полный режим: детальные карточки (неявные DataTemplate по типу события из App.axaml) -->
                <ItemsRepeater ItemsSource="{Binding VisibleEvents}"
                               Margin="10"
                               IsVisible="{Binding IsFullCardMode}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Плотный режим: компакт-карточки по типу события. Регистрация «тип → компакт-карточка»
                     вынесена в CompactEventItem (сами карточки — Controls/EventCards/Compact/*). -->
                <ItemsRepeater ItemsSource="{Binding VisibleEvents}"
                               Margin="10"
                               IsVisible="{Binding IsCompactCardMode}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <local:CompactEventItem />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Panel>
        </ScrollViewer>

        <Border
            Padding="40"
            IsVisible="{Binding !VisibleEvents.Count}">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                MaxWidth="400">

                <TextBlock
                    Text="{loc:Tr Events.NoData}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock
                    Text="{loc:Tr Events.NoDataHint}"
                    FontSize="12"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
